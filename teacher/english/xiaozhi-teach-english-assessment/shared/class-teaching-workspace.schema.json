{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaozhi-skills.openclaw.dev/schemas/class-teaching-workspace.schema.json",
  "title": "ClassTeachingWorkspace",
  "x-distributed-to": "xiaozhi-teach-english-assessment",
  "x-skill-scope": {
    "note": "本副本随 xiaozhi-teach-english-assessment 分发，已按其 SKILL.md 裁剪：只保留正文在非否定语境下提到的字段（共 7 项，删去 4 个顶层字段）。完整定义在归属技能处。读/写权限与授权位以 SKILL.md 为准。",
    "paths": [
      "classProfile",
      "classSummaries",
      "examBlueprints",
      "itemScores",
      "itemStats",
      "reviewPlans",
      "weaknessRank"
    ]
  },
  "description": "班级教学工作空间：老师通用 6 个 SKILL（教案、课堂、作业、测评、复习、学情）与学科教师 SKILL 之间的唯一数据契约。所有接口路径必须是本文件中的真实字段。学生只用化名/座号，不记真实姓名与联系方式。词表以 shared/vocab.md 为准。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "classProfile": {
      "$ref": "#/$defs/classProfile"
    },
    "examBlueprints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/examBlueprint"
      }
    },
    "itemScores": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/itemScore"
      }
    },
    "itemStats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/itemStat"
      }
    },
    "classSummaries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/classSummary"
      }
    },
    "weaknessRank": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/weaknessEntry"
      }
    },
    "reviewPlans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reviewPlan"
      }
    }
  },
  "required": [
    "classProfile"
  ],
  "$defs": {
    "classProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classId": {
          "type": "string",
          "maxLength": 40
        },
        "subject": {
          "type": "string",
          "maxLength": 20
        },
        "gradeBand": {
          "type": "string",
          "enum": [
            "小学低段",
            "小学中段",
            "小学高段",
            "初中",
            "高中"
          ]
        },
        "gradeLevel": {
          "type": "string",
          "maxLength": 10,
          "description": "如 八年级"
        },
        "classSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 80
        },
        "periodMinutes": {
          "type": "integer",
          "enum": [
            30,
            35,
            40,
            45,
            60,
            90
          ],
          "description": "一节课分钟数（小学默认 40，初中默认 45）"
        },
        "textbookVersion": {
          "type": "string",
          "maxLength": 40
        },
        "fullScore": {
          "type": "integer",
          "enum": [
            100,
            120,
            150
          ],
          "description": "本学科常用卷面满分，学情分析的阈值按此换算"
        }
      },
      "required": [
        "classId",
        "subject",
        "gradeBand",
        "periodMinutes"
      ]
    },
    "cognitiveLevel": {
      "type": "string",
      "enum": [
        "了解",
        "理解",
        "掌握",
        "运用"
      ],
      "description": "2022 版课标结果目标四级。与 Bloom 对照：了解≈记忆，理解≈理解，掌握≈应用，运用≈分析/评价/创造"
    },
    "difficultyBand": {
      "type": "string",
      "enum": [
        "基础",
        "中等",
        "较难"
      ],
      "description": "难度档。校内形成性默认 6:3:1，期末/模拟按 7:2:1"
    },
    "tier": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C"
      ],
      "description": "A=需补基础，B=达标，C=可拓展。依据近 3 次测评得分率，课前可得"
    },
    "lessonPlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "planId": {
          "type": "string",
          "maxLength": 40
        },
        "topic": {
          "type": "string",
          "maxLength": 80
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "planType": {
          "type": "string",
          "enum": [
            "新授",
            "复习",
            "讲评",
            "单元起始",
            "单元总结"
          ],
          "description": "讲评课的错题清单与讲评顺序来自 exam-designer；本字段用于区分教案类型"
        },
        "periodMinutes": {
          "type": "integer",
          "enum": [
            30,
            35,
            40,
            45,
            60,
            90
          ]
        },
        "objectives": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "statement": {
                "type": "string",
                "maxLength": 120,
                "description": "可观测目标：学生能…（行为动词 + 条件 + 标准）"
              },
              "cognitiveLevel": {
                "$ref": "#/$defs/cognitiveLevel"
              },
              "coreCompetency": {
                "type": "string",
                "maxLength": 40,
                "description": "对应课标核心素养表现，如 运算能力/推理意识/物理观念"
              }
            },
            "required": [
              "statement",
              "cognitiveLevel"
            ]
          }
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 40
              },
              "minutes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 90
              },
              "activity": {
                "type": "string",
                "maxLength": 300
              },
              "tierVariants": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "A": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "B": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "C": {
                    "type": "string",
                    "maxLength": 200
                  }
                }
              }
            },
            "required": [
              "name",
              "minutes"
            ]
          }
        },
        "questionChain": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "description": "课堂提问链，按 cognitiveLevel 递进"
        },
        "boardPlan": {
          "type": "string",
          "maxLength": 500
        },
        "sourceWeaknessIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 40
          },
          "description": "本课针对的 weaknessRank 条目"
        }
      },
      "required": [
        "planId",
        "topic",
        "periodMinutes",
        "objectives"
      ]
    },
    "interactionLog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logId": {
          "type": "string",
          "maxLength": 40
        },
        "planId": {
          "type": "string",
          "maxLength": 40
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "segmentTimings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 40
              },
              "plannedMinutes": {
                "type": "integer"
              },
              "actualMinutes": {
                "type": "integer"
              }
            }
          }
        },
        "participationNote": {
          "type": "string",
          "maxLength": 300,
          "description": "整体参与度的事实描述；不记录个别学生姓名"
        },
        "questionEffectNote": {
          "type": "string",
          "maxLength": 300,
          "description": "提问链效果：哪一问引发最多思考、哪一问无人回应；只记问题本身，不记学生"
        },
        "misconceptionsObserved": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "adjustmentForNext": {
          "type": "string",
          "maxLength": 300
        }
      },
      "required": [
        "logId",
        "planId",
        "date"
      ]
    },
    "homeworkAssignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assignmentId": {
          "type": "string",
          "maxLength": 40
        },
        "planId": {
          "type": "string",
          "maxLength": 40
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "purpose": {
          "type": "string",
          "enum": [
            "诊断",
            "巩固",
            "补救",
            "拓展"
          ]
        },
        "tasks": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "taskNo": {
                "type": "integer",
                "minimum": 1
              },
              "knowledgePoint": {
                "type": "string",
                "maxLength": 60
              },
              "cognitiveLevel": {
                "$ref": "#/$defs/cognitiveLevel"
              },
              "difficultyBand": {
                "$ref": "#/$defs/difficultyBand"
              },
              "tier": {
                "$ref": "#/$defs/tier"
              },
              "estimatedMinutes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60
              },
              "resourceId": {
                "type": "string",
                "maxLength": 40
              }
            },
            "required": [
              "taskNo",
              "knowledgePoint",
              "estimatedMinutes"
            ]
          }
        },
        "estimatedTotalMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120,
          "description": "本科目本次作业预计总时长；全科总量按学段封顶由老师协调"
        },
        "completionSummary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "submitted": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "commonErrors": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/errorTally"
              }
            }
          }
        }
      },
      "required": [
        "assignmentId",
        "date",
        "purpose",
        "tasks"
      ]
    },
    "errorTally": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "knowledgePoint": {
          "type": "string",
          "maxLength": 60
        },
        "dimension": {
          "type": "string",
          "enum": [
            "概念模糊",
            "计算失误",
            "读题失误",
            "方法用错"
          ]
        },
        "teacherCategory": {
          "type": "string",
          "enum": [
            "知识漏洞",
            "规则错误",
            "计算错误",
            "审题错误",
            "策略错误",
            "表达/书写不规范",
            "习惯性失误"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "knowledgePoint",
        "dimension",
        "count"
      ]
    },
    "examBlueprint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "examId": {
          "type": "string",
          "maxLength": 40
        },
        "title": {
          "type": "string",
          "maxLength": 80
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "assessmentType": {
          "type": "string",
          "enum": [
            "诊断性",
            "形成性",
            "终结性"
          ]
        },
        "durationMinutes": {
          "type": "integer",
          "minimum": 10,
          "maximum": 150
        },
        "fullScore": {
          "type": "integer",
          "minimum": 10,
          "maximum": 150
        },
        "difficultyRatio": {
          "type": "string",
          "pattern": "^[0-9]+:[0-9]+:[0-9]+$",
          "description": "基础:中等:较难，如 6:3:1"
        },
        "cognitiveRatio": {
          "type": "object",
          "additionalProperties": false,
          "description": "四级认知层级的分值占比（%），四项之和应为 100。层级取值见 cognitiveLevel",
          "properties": {
            "了解": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "理解": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "掌握": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "运用": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "itemNo": {
                "type": "integer",
                "minimum": 1
              },
              "itemType": {
                "type": "string",
                "enum": [
                  "选择",
                  "填空",
                  "判断",
                  "计算",
                  "解答",
                  "作图",
                  "实验",
                  "阅读",
                  "写作",
                  "听力",
                  "口语",
                  "其他"
                ]
              },
              "knowledgePoint": {
                "type": "string",
                "maxLength": 60
              },
              "cognitiveLevel": {
                "$ref": "#/$defs/cognitiveLevel"
              },
              "difficultyBand": {
                "$ref": "#/$defs/difficultyBand"
              },
              "score": {
                "type": "number",
                "minimum": 0
              },
              "expectedP": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "预期难度 P（得分率）"
              },
              "resourceId": {
                "type": "string",
                "maxLength": 40
              },
              "aiGenerated": {
                "type": "boolean",
                "default": false
              },
              "verifiedByTeacher": {
                "type": "boolean",
                "default": false,
                "description": "AI 生成题必须人工验算后才能为 true；未验算的题不得进入试卷"
              }
            },
            "required": [
              "itemNo",
              "itemType",
              "knowledgePoint",
              "cognitiveLevel",
              "difficultyBand",
              "score"
            ]
          }
        }
      },
      "required": [
        "examId",
        "title",
        "assessmentType",
        "fullScore",
        "items"
      ]
    },
    "itemScore": {
      "type": "object",
      "additionalProperties": false,
      "description": "逐题得分。studentAlias 用化名/座号。学情分析的热力图与顽固弱项均以此为唯一来源；只有总分时不可生成逐知识点分析",
      "properties": {
        "examId": {
          "type": "string",
          "maxLength": 40
        },
        "studentAlias": {
          "type": "string",
          "maxLength": 20
        },
        "itemNo": {
          "type": "integer",
          "minimum": 1
        },
        "score": {
          "type": "number",
          "minimum": 0
        },
        "maxScore": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "examId",
        "studentAlias",
        "itemNo",
        "score",
        "maxScore"
      ]
    },
    "itemStat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "examId": {
          "type": "string",
          "maxLength": 40
        },
        "itemNo": {
          "type": "integer",
          "minimum": 1
        },
        "pValue": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "难度 = 平均得分 / 满分"
        },
        "dValue": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "区分度 = 高分组得分率 − 低分组得分率；分组按总分前后 27%"
        },
        "groupingMethod": {
          "type": "string",
          "enum": [
            "27%",
            "上下各半"
          ],
          "default": "27%"
        },
        "flag": {
          "type": "string",
          "enum": [
            "正常",
            "偏难",
            "偏易",
            "区分度低",
            "疑似错题"
          ],
          "description": "基础题允许 D<0.2；只对中等/较难题要求 D≥0.2"
        }
      },
      "required": [
        "examId",
        "itemNo",
        "pValue"
      ]
    },
    "classSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "examId": {
          "type": "string",
          "maxLength": 40
        },
        "sampleSize": {
          "type": "integer",
          "minimum": 1
        },
        "mean": {
          "type": "number"
        },
        "sd": {
          "type": "number",
          "minimum": 0
        },
        "median": {
          "type": "number"
        },
        "meanRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "平均得分率（跨满分制可比）"
        },
        "distribution": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "band": {
                "type": "string",
                "maxLength": 20
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "band",
              "count"
            ]
          }
        },
        "dataCompleteness": {
          "type": "string",
          "enum": [
            "逐题",
            "仅总分"
          ],
          "default": "仅总分",
          "description": "itemScores 是否为逐题分数。为 仅总分 时只能输出分数分布，不得生成知识点热力图、区分度、α"
        },
        "reliabilityAlpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Cronbach α；需要逐题分数，样本 <20 时标注参考价值有限"
        },
        "overallDifficulty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "analysisDate": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "examId",
        "sampleSize",
        "meanRate"
      ]
    },
    "weaknessEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weaknessId": {
          "type": "string",
          "maxLength": 40
        },
        "knowledgePoint": {
          "type": "string",
          "maxLength": 60
        },
        "errorRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dimension": {
          "type": "string",
          "enum": [
            "概念模糊",
            "计算失误",
            "读题失误",
            "方法用错"
          ]
        },
        "stubbornCount": {
          "type": "integer",
          "minimum": 0,
          "description": "近 4 次测评中错误率 >30% 的次数（shared/vocab.md §5 老师端口径）"
        },
        "evidenceExamIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 40
          }
        },
        "lastUpdated": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "weaknessId",
        "knowledgePoint",
        "errorRate"
      ]
    },
    "studentTier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "studentAlias": {
          "type": "string",
          "maxLength": 20
        },
        "tier": {
          "$ref": "#/$defs/tier"
        },
        "basis": {
          "type": "string",
          "maxLength": 100,
          "description": "如 近 3 次测评平均得分率 0.62"
        },
        "updatedAt": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "studentAlias",
        "tier"
      ]
    },
    "reviewPlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reviewId": {
          "type": "string",
          "maxLength": 40
        },
        "targetExamId": {
          "type": "string",
          "maxLength": 40
        },
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "endDate": {
          "type": "string",
          "format": "date"
        },
        "phases": {
          "type": "array",
          "description": "按距考天数倒推的阶段。距考 3 天内不得引入新内容；考试当天只做状态保持，不点弱项",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 40
              },
              "daysToExam": {
                "type": "string",
                "maxLength": 20,
                "description": "如 >14 / 7-14 / 3-7 / 1-3 / 0"
              },
              "emphasis": {
                "type": "string",
                "maxLength": 200
              },
              "newContentAllowed": {
                "type": "boolean",
                "default": true
              }
            },
            "required": [
              "name",
              "daysToExam"
            ]
          }
        },
        "spacingSchedule": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "knowledgePoint": {
                "type": "string",
