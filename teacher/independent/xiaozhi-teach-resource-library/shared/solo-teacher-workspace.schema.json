{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaozhi-skills.openclaw.dev/schemas/solo-teacher-workspace.schema.json",
  "title": "SoloTeacherWorkspace",
  "x-distributed-to": "xiaozhi-teach-resource-library",
  "x-skill-scope": {
    "note": "本副本随 xiaozhi-teach-resource-library 分发，已按其 SKILL.md 的“读：/写：”声明裁剪：读 homeworkFollowups、lessonLogs、studentCards；写 resourceLibraryIndex（同一键既读又写时，读/写各自的子字段列在 x-skill-scope.fields；各字段只留声明列出的子字段；删去 5 个顶层字段）。完整定义在归属技能处。",
    "paths": [
      "homeworkFollowups",
      "lessonLogs",
      "resourceLibraryIndex",
      "studentCards"
    ],
    "reads": [
      "homeworkFollowups",
      "lessonLogs",
      "studentCards"
    ],
    "writes": [
      "resourceLibraryIndex"
    ],
    "fields": {
      "studentCards": {
        "reads": [
          "gradeBand",
          "primaryWeaknesses",
          "alias",
          "gradeLevel",
          "subjects",
          "goals"
        ]
      },
      "homeworkFollowups": {
        "reads": [
          "mainErrors"
        ]
      },
      "lessonLogs": {
        "reads": [
          "completedContent",
          "nextLessonFocus"
        ]
      },
      "resourceLibraryIndex": {
        "writes": [
          "resourceId",
          "title",
          "resourceType",
          "subject",
          "gradeLevel",
          "knowledgePoint",
          "difficulty",
          "copyrightStatus",
          "aiGenerated",
          "verifiedByTeacher",
          "usageNotes"
        ]
      }
    }
  },
  "description": "独立教师工作空间数据结构。用于低敏记录学员卡、课表、课后记录、作业跟进、家长沟通、课时包和阶段证据。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "studentCards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/studentCard"
      }
    },
    "lessonLogs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lessonLog"
      }
    },
    "homeworkFollowups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/homeworkFollowup"
      }
    },
    "resourceLibraryIndex": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resourceIndexItem"
      }
    }
  },
  "required": [],
  "$defs": {
    "studentCard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "studentId": {
          "type": "string"
        },
        "alias": {
          "type": "string",
          "description": "低敏代号，不记录真实全名"
        },
        "gradeLevel": {
          "type": "string"
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "primaryWeaknesses": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "maxLength": 60
          },
          "description": "仅在老师确认后写入；由作业跟进自动建议的弱项先进入 progressEvidence（shared/vocab.md §5）"
        },
        "gradeBand": {
          "type": "string",
          "enum": [
            "小学低段",
            "小学中段",
            "小学高段",
            "初中",
            "高中",
            "未知"
          ],
          "description": "学段（shared/vocab.md §10）"
        }
      },
      "required": [
        "studentId",
        "alias"
      ]
    },
    "lessonLog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logId": {
          "type": "string"
        },
        "lessonId": {
          "type": "string"
        },
        "studentId": {
          "type": "string"
        },
        "completedContent": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "masteryStatus": {
          "type": "string",
          "enum": [
            "已掌握",
            "基本理解",
            "仍需巩固",
            "需要重讲",
            "证据不足"
          ]
        },
        "nextLessonFocus": {
          "type": "string",
          "maxLength": 500
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "上课日期，用于仪表盘‘最近 N 条’规则"
        }
      },
      "required": [
        "logId",
        "lessonId",
        "studentId",
        "date",
        "masteryStatus"
      ]
    },
    "homeworkFollowup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "homeworkId": {
          "type": "string"
        },
        "studentId": {
          "type": "string"
        },
        "task": {
          "type": "string",
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": [
            "已布置",
            "已提交",
            "部分提交",
            "未交",
            "已批改",
            "已订正",
            "已减免"
          ]
        },
        "mainErrors": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "knowledgePoint": {
                "type": "string",
                "maxLength": 60
              },
              "dimension": {
                "type": "string",
                "enum": [
                  "概念模糊",
                  "计算失误",
                  "读题失误",
                  "方法用错"
                ]
              },
              "teacherCategory": {
                "type": "string",
                "enum": [
                  "知识漏洞",
                  "规则错误",
                  "计算错误",
                  "审题错误",
                  "策略错误",
                  "表达/书写不规范",
                  "习惯性失误"
                ]
              }
            },
            "required": [
              "knowledgePoint",
              "dimension"
            ]
          },
          "description": "错因按 shared/vocab.md §1/§3 记录；teacherCategory 为老师端七类，写入时必须同时给出通用四维 dimension"
        }
      },
      "required": [
        "homeworkId",
        "studentId",
        "task",
        "status"
      ]
    },
    "resourceIndexItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resourceId": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "resourceType": {
          "type": "string",
          "enum": [
            "题目",
            "讲义",
            "课件",
            "板书",
            "讲评话术",
            "错因案例",
            "家长话术"
          ]
        },
        "subject": {
          "type": "string",
          "maxLength": 60
        },
        "gradeLevel": {
          "type": "string",
          "maxLength": 60
        },
        "knowledgePoint": {
          "type": "string",
          "maxLength": 60
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "基础",
            "中等",
            "提升",
            "挑战"
          ]
        },
        "copyrightStatus": {
          "type": "string",
          "enum": [
            "自有",
            "改编",
            "公开可引用",
            "仅存索引"
          ]
        },
        "usageNotes": {
          "type": "string",
          "maxLength": 500
        },
        "aiGenerated": {
          "type": "boolean",
          "default": false,
          "description": "AI 生成的题目/材料必须为 true，且 verifiedByTeacher 为 true 后方可用于学生"
        },
        "verifiedByTeacher": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "resourceId",
        "title",
        "resourceType",
        "copyrightStatus"
      ]
    }
  }
}
