{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaozhi-skills.openclaw.dev/schemas/solo-teacher-workspace.schema.json",
  "title": "SoloTeacherWorkspace",
  "description": "独立教师工作空间数据结构。用于低敏记录学员卡、课表、课后记录、作业跟进、家长沟通、课时包和阶段证据。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "teacherProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "teacherId": {
          "type": "string"
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "serviceModes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "一对一",
              "小班"
            ]
          }
        },
        "deliveryChannels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "线上",
              "线下"
            ]
          }
        }
      },
      "required": [
        "teacherId"
      ]
    },
    "studentCards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/studentCard"
      }
    },
    "lessonSchedule": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lessonEvent"
      }
    },
    "lessonLogs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lessonLog"
      }
    },
    "homeworkFollowups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/homeworkFollowup"
      }
    },
    "parentCommunicationLogs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parentCommunication"
      }
    },
    "coursePackageLedger": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coursePackage"
      }
    },
    "progressEvidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/progressEvidence"
      }
    },
    "resourceLibraryIndex": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resourceIndexItem"
      }
    }
  },
  "required": [
    "teacherProfile"
  ],
  "$defs": {
    "studentCard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "studentId": {
          "type": "string"
        },
        "alias": {
          "type": "string",
          "description": "低敏代号，不记录真实全名"
        },
        "gradeLevel": {
          "type": "string"
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "primaryWeaknesses": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "maxLength": 60
          },
          "description": "仅在老师确认后写入；由作业跟进自动建议的弱项先进入 progressEvidence（shared/vocab.md §5）"
        },
        "learningPreferences": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          },
          "description": "学习方式偏好（如喜欢先看例题、需要多写步骤）。不用于排课，时间冲突检测一律读 availability[]"
        },
        "availability": {
          "type": "array",
          "maxItems": 21,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "dayOfWeek": {
                "type": "string",
                "enum": [
                  "周一",
                  "周二",
                  "周三",
                  "周四",
                  "周五",
                  "周六",
                  "周日"
                ]
              },
              "startTime": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                "description": "24 小时制 HH:MM"
              },
              "endTime": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                "description": "24 小时制 HH:MM，须晚于 startTime"
              }
            },
            "required": [
              "dayOfWeek",
              "startTime",
              "endTime"
            ]
          },
          "description": "学员每周可上课时间段，排课冲突检测的唯一依据。只记时间，不记原因（不写“周三要上钢琴课”）"
        },
        "guardianCommunicationPreference": {
          "type": "string",
          "enum": [
            "微信文字",
            "微信语音",
            "电话",
            "线下面谈",
            "邮件",
            "不主动联系"
          ],
          "description": "仅记录偏好的沟通方式，禁止填写任何联系方式（电话号码、微信号、邮箱地址）"
        },
        "consent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profileEnabled": {
              "type": "boolean",
              "default": false
            },
            "crossSkillSharing": {
              "type": "boolean",
              "default": false
            },
            "parentCommunicationAllowed": {
              "type": "boolean",
              "default": false
            },
            "emotionSharingWithParent": {
              "type": "boolean",
              "default": false,
              "description": "是否允许向家长转述学员的情绪观察（仅事实，不做推测）"
            },
            "grantedBy": {
              "type": "string",
              "enum": [
                "学生本人",
                "监护人",
                "学生与监护人",
                "未记录"
              ],
              "default": "未记录"
            },
            "grantedAt": {
              "type": "string",
              "format": "date-time"
            },
            "retentionUntil": {
              "type": "string",
              "format": "date",
              "description": "保留期限；结课后默认 6 个月，到期提示老师删除"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "在读",
            "暂停记录",
            "已结课",
            "待删除"
          ],
          "default": "在读",
          "description": "暂停记录：不再写入任何新记录；待删除：等待老师确认后整卡删除"
        },
        "gradeBand": {
          "type": "string",
          "enum": [
            "小学低段",
            "小学中段",
            "小学高段",
            "初中",
            "高中",
            "未知"
          ],
          "description": "学段（shared/vocab.md §10）"
        }
      },
      "required": [
        "studentId",
        "alias"
      ]
    },
    "lessonEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lessonId": {
          "type": "string"
        },
        "studentId": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "startTime": {
          "type": "string",
          "format": "date-time"
        },
        "durationMinutes": {
          "type": "integer",
          "minimum": 15
        },
        "day_of_week": {
          "type": "string",
          "enum": [
            "周一",
            "周二",
            "周三",
            "周四",
            "周五",
            "周六",
            "周日",
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday",
            "Saturday",
            "Sunday"
          ],
          "description": "兼容中英文的排课星期枚举，中文优先"
        },
        "status": {
          "type": "string",
          "enum": [
            "scheduled",
            "completed",
            "rescheduled",
            "makeup",
            "cancelled",
            "absence",
            "trial"
          ],
          "description": "trial=试听课"
        },
        "lessonGoal": {
          "type": "string"
        }
      },
      "required": [
        "lessonId",
        "studentId",
        "subject",
        "startTime",
        "status"
      ]
    },
    "lessonLog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logId": {
          "type": "string"
        },
        "lessonId": {
          "type": "string"
        },
        "studentId": {
          "type": "string"
        },
        "completedContent": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "masteryStatus": {
          "type": "string",
          "enum": [
            "已掌握",
            "基本理解",
            "仍需巩固",
            "需要重讲",
            "证据不足"
          ]
        },
        "nextLessonFocus": {
          "type": "string",
          "maxLength": 500
        },
        "parentSummary": {
          "type": "string",
          "maxLength": 500,
          "description": "面向家长的事实摘要，受 500 字符硬约束。禁止写入真实姓名、家庭住址、身份证件、联系电话、账户信息、医疗诊断、心理标签、家庭纠纷、财务细节等高敏信息。"
        },
        "consumeLessonUnits": {
          "type": "number",
          "minimum": 0,
          "description": "本节课消耗课时数。由 SKILL 生成为待确认条目，老师确认后才写入课时台账"
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "上课日期，用于仪表盘‘最近 N 条’规则"
        },
        "perTopicMastery": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "topic": {
                "type": "string",
                "maxLength": 60
              },
              "masteryStatus": {
                "type": "string",
                "enum": [
                  "已掌握",
                  "基本理解",
                  "仍需巩固",
                  "需要重讲",
                  "证据不足"
                ]
              }
            },
            "required": [
              "topic",
              "masteryStatus"
            ]
          },
          "description": "本节课各知识点掌握情况；masteryStatus 为整体判断"
        },
        "studentReaction": {
          "type": "string",
          "enum": [
            "投入",
            "平稳",
            "疲惫",
            "抗拒",
            "未观察"
          ],
          "description": "课堂反应的低敏事实描述，不做情绪推测，不写触发原因"
        }
      },
      "required": [
        "logId",
        "lessonId",
        "studentId",
        "date",
        "masteryStatus"
      ]
    },
    "homeworkFollowup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "homeworkId": {
          "type": "string"
        },
        "studentId": {
          "type": "string"
        },
        "task": {
          "type": "string",
          "maxLength": 500
        },
        "dueDate": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "type": "string",
          "enum": [
            "已布置",
            "已提交",
            "部分提交",
            "未交",
            "已批改",
            "已订正",
            "已减免"
          ]
        },
        "mainErrors": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "knowledgePoint": {
                "type": "string",
                "maxLength": 60
              },
              "dimension": {
                "type": "string",
                "enum": [
                  "概念模糊",
                  "计算失误",
                  "读题失误",
                  "方法用错"
                ]
              },
              "teacherCategory": {
                "type": "string",
                "enum": [
                  "知识漏洞",
                  "规则错误",
                  "计算错误",
                  "审题错误",
                  "策略错误",
                  "表达/书写不规范",
                  "习惯性失误"
                ]
              }
            },
            "required": [
              "knowledgePoint",
              "dimension"
            ]
          },
          "description": "错因按 shared/vocab.md §1/§3 记录；teacherCategory 为老师端七类，写入时必须同时给出通用四维 dimension"
        },
        "nextAction": {
          "type": "string",
          "maxLength": 500
        },
        "overdueDays": {
          "type": "integer",
          "minimum": 0,
          "description": "逾期天数（由 dueDate 与当前日期派生，仪表盘‘逾期’规则据此判断，status 中无 overdue 值）"
        }
      },
      "required": [
        "homeworkId",
        "studentId",
        "task",
        "status"
      ]
    },
    "parentCommunication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "communicationId": {
          "type": "string"
        },
        "studentId": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date-time"
        },
        "scenario": {
          "type": "string",
          "enum": [
            "课后反馈",
            "周反馈",
            "问题沟通",
            "调课确认",
            "阶段报告",
            "续课说明"
          ]
        },
        "factSummary": {
          "type": "string",
          "maxLength": 500,
          "description": "沟通事实摘要，受 500 字符硬约束。禁止写入真实姓名、家庭住址、身份证件、联系电话、账户信息、医疗诊断、心理标签、家庭纠纷、财务细节等高敏信息。"
        },
        "actionSuggestion": {
          "type": "string",
          "maxLength": 500
        },
        "sentStatus": {
          "type": "string",
          "enum": [
            "draft",
            "sent",
            "not_sent"
          ]
        },
        "channel": {
          "type": "string",
          "enum": [
            "私聊文字",
            "私聊语音",
            "电话",
            "线下面谈",
            "群公告"
          ],
          "description": "沟通渠道，不记录联系方式"
        }
      },
      "required": [
        "communicationId",
        "studentId",
        "date",
        "scenario",
        "sentStatus"
      ]
    },
    "coursePackage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packageId": {
          "type": "string"
        },
        "studentId": {
          "type": "string"
        },
        "totalUnits": {
          "type": "number",
          "minimum": 0
        },
        "usedUnits": {
          "type": "number",
          "minimum": 0
        },
        "remainingUnits": {
          "type": "number",
          "minimum": 0
        },
        "renewalAttention": {
          "type": "boolean",
          "default": false
        },
        "expiryDate": {
          "type": "string",
          "format": "date",
          "description": "课时包到期日，用于‘到期前 7 天’提示"
        },
        "pendingConfirmations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "lessonId": {
                "type": "string",
                "maxLength": 60
              },
              "units": {
                "type": "number",
                "minimum": 0
              },
              "generatedAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "lessonId",
              "units"
            ]
          },
          "description": "待老师确认的课时扣减条目；确认后才计入 usedUnits"
        }
      },
      "required": [
        "packageId",
        "studentId",
        "totalUnits",
        "usedUnits",
        "remainingUnits"
      ]
    },
    "progressEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidenceId": {
          "type": "string"
        },
        "studentId": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "evidenceType": {
          "type": "string",
          "enum": [
            "课堂表现",
            "作业",
            "测评",
            "订正",
            "口头表达",
            "家长反馈"
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "进步证据的事实描述，受 500 字符硬约束。禁止写入真实姓名、联系方式、家庭/医疗/财务等高敏信息。"
        },
        "confidenceLevel": {
          "type": "string",
          "enum": [
            "data_sufficient",
            "preliminary_trend",
            "insufficient_sample"
          ]
        }
      },
      "required": [
        "evidenceId",
        "studentId",
        "date",
        "evidenceType",
        "description"
      ]
    },
    "resourceIndexItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resourceId": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "resourceType": {
          "type": "string",
          "enum": [
            "题目",
            "讲义",
            "课件",
            "板书",
            "讲评话术",
            "错因案例",
            "家长话术"
          ]
        },
        "subject": {
          "type": "string",
          "maxLength": 60
        },
        "gradeLevel": {
          "type": "string",
          "maxLength": 60
        },
        "knowledgePoint": {
          "type": "string",
          "maxLength": 60
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "基础",
            "中等",
            "提升",
            "挑战"
          ]
        },
        "copyrightStatus": {
          "type": "string",
          "enum": [
            "自有",
            "改编",
            "公开可引用",
            "仅存索引"
          ]
        },
        "usageNotes": {
          "type": "string",
          "maxLength": 500
        },
        "aiGenerated": {
          "type": "boolean",
          "default": false,
          "description": "AI 生成的题目/材料必须为 true，且 verifiedByTeacher 为 true 后方可用于学生"
        },
        "verifiedByTeacher": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "resourceId",
        "title",
        "resourceType",
        "copyrightStatus"
      ]
    }
  }
}
