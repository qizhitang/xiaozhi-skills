{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaozhi-skills.openclaw.dev/schemas/solo-teacher-workspace.schema.json",
  "title": "SoloTeacherWorkspace",
  "x-distributed-to": "xiaozhi-teach-parent-communication",
  "x-skill-scope": {
    "note": "本副本随 xiaozhi-teach-parent-communication 分发，已按其 SKILL.md 的“读：/写：”声明裁剪：读 coursePackageLedger、homeworkFollowups、lessonLogs、progressEvidence、studentCards；写 parentCommunicationLogs（同一键既读又写时，读/写各自的子字段列在 x-skill-scope.fields；各字段只留声明列出的子字段；删去 3 个顶层字段）。完整定义在归属技能处。",
    "paths": [
      "coursePackageLedger",
      "homeworkFollowups",
      "lessonLogs",
      "parentCommunicationLogs",
      "progressEvidence",
      "studentCards"
    ],
    "reads": [
      "coursePackageLedger",
      "homeworkFollowups",
      "lessonLogs",
      "progressEvidence",
      "studentCards"
    ],
    "writes": [
      "parentCommunicationLogs"
    ],
    "fields": {
      "studentCards": {
        "reads": [
          "consent",
          "alias",
          "gradeBand",
          "status",
          "guardianCommunicationPreference"
        ]
      },
      "lessonLogs": {
        "reads": [
          "parentSummary",
          "completedContent",
          "evidence",
          "masteryStatus",
          "perTopicMastery",
          "studentReaction",
          "date"
        ]
      },
      "homeworkFollowups": {
        "reads": [
          "status",
          "overdueDays",
          "mainErrors",
          "nextAction"
        ]
      },
      "coursePackageLedger": {
        "reads": [
          "usedUnits",
          "remainingUnits",
          "expiryDate",
          "pendingConfirmations",
          "renewalAttention"
        ]
      },
      "progressEvidence": {
        "reads": [
          "description",
          "confidenceLevel"
        ]
      },
      "parentCommunicationLogs": {
        "writes": [
          "date",
          "scenario",
          "channel",
          "factSummary",
          "sentStatus"
        ]
      }
    }
  },
  "description": "独立教师工作空间数据结构。用于低敏记录学员卡、课表、课后记录、作业跟进、家长沟通、课时包和阶段证据。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "studentCards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/studentCard"
      }
    },
    "lessonLogs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lessonLog"
      }
    },
    "homeworkFollowups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/homeworkFollowup"
      }
    },
    "parentCommunicationLogs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parentCommunication"
      }
    },
    "coursePackageLedger": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coursePackage"
      }
    },
    "progressEvidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/progressEvidence"
      }
    }
  },
  "required": [],
  "$defs": {
    "studentCard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "studentId": {
          "type": "string"
        },
        "alias": {
          "type": "string",
          "description": "低敏代号，不记录真实全名"
        },
        "guardianCommunicationPreference": {
          "type": "string",
          "enum": [
            "微信文字",
            "微信语音",
            "电话",
            "线下面谈",
            "邮件",
            "不主动联系"
          ],
          "description": "仅记录偏好的沟通方式，禁止填写任何联系方式（电话号码、微信号、邮箱地址）"
        },
        "consent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profileEnabled": {
              "type": "boolean",
              "default": false
            },
            "crossSkillSharing": {
              "type": "boolean",
              "default": false
            },
            "parentCommunicationAllowed": {
              "type": "boolean",
              "default": false
            },
            "emotionSharingWithParent": {
              "type": "boolean",
              "default": false,
              "description": "是否允许向家长转述学员的情绪观察（仅事实，不做推测）"
            },
            "grantedBy": {
              "type": "string",
              "enum": [
                "学生本人",
                "监护人",
                "学生与监护人",
                "未记录"
              ],
              "default": "未记录"
            },
            "grantedAt": {
              "type": "string",
              "format": "date-time"
            },
            "retentionUntil": {
              "type": "string",
              "format": "date",
              "description": "保留期限。已报名学员：结课后默认 6 个月。未报名的试听学员：试听日 + 90 天。到期由建档技能提示老师确认删除或延期，不自动删除、不自动续期。"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "在读",
            "暂停记录",
            "已结课",
            "待删除"
          ],
          "default": "在读",
          "description": "暂停记录：不再写入任何新记录；待删除：等待老师确认后整卡删除"
        },
        "gradeBand": {
          "type": "string",
          "enum": [
            "小学低段",
            "小学中段",
            "小学高段",
            "初中",
            "高中",
            "未知"
          ],
          "description": "学段（shared/vocab.md §10）"
        }
      },
      "required": [
        "studentId",
        "alias"
      ]
    },
    "lessonLog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logId": {
          "type": "string"
        },
        "lessonId": {
          "type": "string"
        },
        "studentId": {
          "type": "string"
        },
        "completedContent": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "masteryStatus": {
          "type": "string",
          "enum": [
            "已掌握",
            "基本理解",
            "仍需巩固",
            "需要重讲",
            "证据不足"
          ]
        },
        "parentSummary": {
          "type": "string",
          "maxLength": 500,
          "description": "面向家长的事实摘要，受 500 字符硬约束。禁止写入真实姓名、家庭住址、身份证件、联系电话、账户信息、医疗诊断、心理标签、家庭纠纷、财务细节等高敏信息。"
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "上课日期，用于仪表盘‘最近 N 条’规则"
        },
        "perTopicMastery": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "topic": {
                "type": "string",
                "maxLength": 60
              },
              "masteryStatus": {
                "type": "string",
                "enum": [
                  "已掌握",
                  "基本理解",
                  "仍需巩固",
                  "需要重讲",
                  "证据不足"
                ]
              }
            },
            "required": [
              "topic",
              "masteryStatus"
            ]
          },
          "description": "本节课各知识点掌握情况；masteryStatus 为整体判断"
        },
        "studentReaction": {
          "type": "string",
          "enum": [
            "投入",
            "平稳",
            "疲惫",
            "抗拒",
            "未观察"
          ],
          "description": "课堂反应的低敏事实描述，不做情绪推测，不写触发原因"
        }
      },
      "required": [
        "logId",
        "lessonId",
        "studentId",
        "date",
        "masteryStatus"
      ]
    },
    "homeworkFollowup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "homeworkId": {
          "type": "string"
        },
        "studentId": {
          "type": "string"
        },
        "task": {
          "type": "string",
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": [
            "已布置",
            "已提交",
            "部分提交",
            "未交",
            "已批改",
            "已订正",
            "已减免"
          ]
        },
        "mainErrors": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "knowledgePoint": {
                "type": "string",
                "maxLength": 60
              },
              "dimension": {
                "type": "string",
                "enum": [
                  "概念模糊",
                  "计算失误",
                  "读题失误",
                  "方法用错"
                ]
              },
              "teacherCategory": {
                "type": "string",
                "enum": [
                  "知识漏洞",
                  "规则错误",
                  "计算错误",
                  "审题错误",
                  "策略错误",
                  "表达/书写不规范",
                  "习惯性失误"
                ]
              }
            },
            "required": [
              "knowledgePoint",
              "dimension"
            ]
          },
          "description": "错因按 shared/vocab.md §1/§3 记录；teacherCategory 为老师端七类，写入时必须同时给出通用四维 dimension"
        },
        "nextAction": {
          "type": "string",
          "maxLength": 500
        },
        "overdueDays": {
          "type": "integer",
          "minimum": 0,
          "description": "逾期天数（由 dueDate 与当前日期派生，仪表盘‘逾期’规则据此判断，status 中无 overdue 值）"
        }
      },
      "required": [
        "homeworkId",
        "studentId",
        "task",
        "status"
      ]
    },
    "parentCommunication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "communicationId": {
          "type": "string"
        },
        "studentId": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date-time"
        },
        "scenario": {
          "type": "string",
          "enum": [
            "课后反馈",
            "周反馈",
            "问题沟通",
            "调课确认",
            "阶段报告",
            "续课说明"
          ]
        },
        "factSummary": {
          "type": "string",
          "maxLength": 500,
          "description": "沟通事实摘要，受 500 字符硬约束。禁止写入真实姓名、家庭住址、身份证件、联系电话、账户信息、医疗诊断、心理标签、家庭纠纷、财务细节等高敏信息。"
        },
        "sentStatus": {
          "type": "string",
          "enum": [
            "draft",
            "sent",
            "not_sent"
          ]
        },
        "channel": {
          "type": "string",
          "enum": [
            "私聊文字",
            "私聊语音",
            "电话",
            "线下面谈",
            "群公告"
          ],
          "description": "沟通渠道，不记录联系方式"
        }
      },
      "required": [
        "communicationId",
        "studentId",
        "date",
        "scenario",
        "sentStatus"
      ]
    },
    "coursePackage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packageId": {
          "type": "string"
        },
        "studentId": {
          "type": "string"
        },
        "totalUnits": {
          "type": "number",
          "minimum": 0
        },
        "usedUnits": {
          "type": "number",
          "minimum": 0
        },
        "remainingUnits": {
          "type": "number",
          "minimum": 0
        },
        "renewalAttention": {
          "type": "boolean",
          "default": false
        },
        "expiryDate": {
          "type": "string",
          "format": "date",
          "description": "课时包到期日，用于‘到期前 7 天’提示"
        },
        "pendingConfirmations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "lessonId": {
                "type": "string",
                "maxLength": 60
              },
              "units": {
                "type": "number",
                "minimum": 0
              },
              "generatedAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "lessonId",
              "units"
            ]
          },
          "description": "待老师确认的课时扣减条目；确认后才计入 usedUnits"
        }
      },
      "required": [
        "packageId",
        "studentId",
        "totalUnits",
        "usedUnits",
        "remainingUnits"
      ]
    },
    "progressEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidenceId": {
          "type": "string"
        },
        "studentId": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "evidenceType": {
          "type": "string",
          "enum": [
            "课堂表现",
            "作业",
            "测评",
            "订正",
            "口头表达",
            "家长反馈"
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "进步证据的事实描述，受 500 字符硬约束。禁止写入真实姓名、联系方式、家庭/医疗/财务等高敏信息。"
        },
        "confidenceLevel": {
          "type": "string",
          "enum": [
            "data_sufficient",
            "preliminary_trend",
            "insufficient_sample"
          ]
        }
      },
      "required": [
        "evidenceId",
        "studentId",
        "date",
        "evidenceType",
        "description"
      ]
    }
  }
}
