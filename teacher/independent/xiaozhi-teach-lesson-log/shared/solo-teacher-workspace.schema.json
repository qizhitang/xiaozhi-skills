{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaozhi-skills.openclaw.dev/schemas/solo-teacher-workspace.schema.json",
  "title": "SoloTeacherWorkspace",
  "x-distributed-to": "xiaozhi-teach-lesson-log",
  "x-skill-scope": {
    "note": "本副本随 xiaozhi-teach-lesson-log 分发，已按其 SKILL.md 的“读：/写：”声明裁剪：只读 lessonSchedule、studentCards；写 coursePackageLedger、lessonLogs、progressEvidence（各字段只留声明列出的子字段；删去 4 个顶层字段）。完整定义在归属技能处。",
    "paths": [
      "coursePackageLedger",
      "lessonLogs",
      "lessonSchedule",
      "progressEvidence",
      "studentCards"
    ],
    "reads": [
      "lessonSchedule",
      "studentCards"
    ],
    "writes": [
      "coursePackageLedger",
      "lessonLogs",
      "progressEvidence"
    ]
  },
  "description": "独立教师工作空间数据结构。用于低敏记录学员卡、课表、课后记录、作业跟进、家长沟通、课时包和阶段证据。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "studentCards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/studentCard"
      }
    },
    "lessonSchedule": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lessonEvent"
      }
    },
    "lessonLogs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lessonLog"
      }
    },
    "coursePackageLedger": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coursePackage"
      }
    },
    "progressEvidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/progressEvidence"
      }
    }
  },
  "required": [],
  "$defs": {
    "studentCard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "studentId": {
          "type": "string"
        },
        "alias": {
          "type": "string",
          "description": "低敏代号，不记录真实全名"
        },
        "gradeLevel": {
          "type": "string"
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "primaryWeaknesses": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "maxLength": 60
          },
          "description": "仅在老师确认后写入；由作业跟进自动建议的弱项先进入 progressEvidence（shared/vocab.md §5）"
        },
        "consent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profileEnabled": {
              "type": "boolean",
              "default": false
            },
            "crossSkillSharing": {
              "type": "boolean",
              "default": false
            },
            "parentCommunicationAllowed": {
              "type": "boolean",
              "default": false
            },
            "emotionSharingWithParent": {
              "type": "boolean",
              "default": false,
              "description": "是否允许向家长转述学员的情绪观察（仅事实，不做推测）"
            },
            "grantedBy": {
              "type": "string",
              "enum": [
                "学生本人",
                "监护人",
                "学生与监护人",
                "未记录"
              ],
              "default": "未记录"
            },
            "grantedAt": {
              "type": "string",
              "format": "date-time"
            },
            "retentionUntil": {
              "type": "string",
              "format": "date",
              "description": "保留期限。已报名学员：结课后默认 6 个月。未报名的试听学员：试听日 + 90 天。到期由建档技能提示老师确认删除或延期，不自动删除、不自动续期。"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "在读",
            "暂停记录",
            "已结课",
            "待删除"
          ],
          "default": "在读",
          "description": "暂停记录：不再写入任何新记录；待删除：等待老师确认后整卡删除"
        },
        "gradeBand": {
          "type": "string",
          "enum": [
            "小学低段",
            "小学中段",
            "小学高段",
            "初中",
            "高中",
            "未知"
          ],
          "description": "学段（shared/vocab.md §10）"
        }
      },
      "required": [
        "studentId",
        "alias"
      ]
    },
    "lessonEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lessonId": {
          "type": "string"
        },
        "studentId": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "startTime": {
          "type": "string",
          "format": "date-time"
        },
        "durationMinutes": {
          "type": "integer",
          "minimum": 15
        },
        "status": {
          "type": "string",
          "enum": [
            "scheduled",
            "completed",
            "rescheduled",
            "makeup",
            "cancelled",
            "absence",
            "trial"
          ],
          "description": "trial=试听课"
        },
        "lessonGoal": {
          "type": "string"
        }
      },
      "required": [
        "lessonId",
        "studentId",
        "subject",
        "startTime",
        "status"
      ]
    },
    "lessonLog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logId": {
          "type": "string"
        },
        "lessonId": {
          "type": "string"
        },
        "studentId": {
          "type": "string"
        },
        "completedContent": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "masteryStatus": {
          "type": "string",
          "enum": [
            "已掌握",
            "基本理解",
            "仍需巩固",
            "需要重讲",
            "证据不足"
          ]
        },
        "nextLessonFocus": {
          "type": "string",
          "maxLength": 500
        },
        "parentSummary": {
          "type": "string",
          "maxLength": 500,
          "description": "面向家长的事实摘要，受 500 字符硬约束。禁止写入真实姓名、家庭住址、身份证件、联系电话、账户信息、医疗诊断、心理标签、家庭纠纷、财务细节等高敏信息。"
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "上课日期，用于仪表盘‘最近 N 条’规则"
        },
        "perTopicMastery": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "topic": {
                "type": "string",
                "maxLength": 60
              },
              "masteryStatus": {
                "type": "string",
                "enum": [
                  "已掌握",
                  "基本理解",
                  "仍需巩固",
                  "需要重讲",
                  "证据不足"
                ]
              }
            },
            "required": [
              "topic",
              "masteryStatus"
            ]
          },
          "description": "本节课各知识点掌握情况；masteryStatus 为整体判断"
        },
        "studentReaction": {
          "type": "string",
          "enum": [
            "投入",
            "平稳",
            "疲惫",
            "抗拒",
            "未观察"
          ],
          "description": "课堂反应的低敏事实描述，不做情绪推测，不写触发原因"
        }
      },
      "required": [
        "logId",
        "lessonId",
        "studentId",
        "date",
        "masteryStatus"
      ]
    },
    "coursePackage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packageId": {
          "type": "string"
        },
        "studentId": {
          "type": "string"
        },
        "totalUnits": {
          "type": "number",
          "minimum": 0
        },
        "usedUnits": {
          "type": "number",
          "minimum": 0
        },
        "remainingUnits": {
          "type": "number",
          "minimum": 0
        },
        "pendingConfirmations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "lessonId": {
                "type": "string",
                "maxLength": 60
              },
              "units": {
                "type": "number",
                "minimum": 0
              },
              "generatedAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "lessonId",
              "units"
            ]
          },
          "description": "待老师确认的课时扣减条目；确认后才计入 usedUnits"
        }
      },
      "required": [
        "packageId",
        "studentId",
        "totalUnits",
        "usedUnits",
        "remainingUnits"
      ]
    },
    "progressEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidenceId": {
          "type": "string"
        },
        "studentId": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "evidenceType": {
          "type": "string",
          "enum": [
            "课堂表现",
            "作业",
            "测评",
            "订正",
            "口头表达",
            "家长反馈"
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "进步证据的事实描述，受 500 字符硬约束。禁止写入真实姓名、联系方式、家庭/医疗/财务等高敏信息。"
        },
        "confidenceLevel": {
          "type": "string",
          "enum": [
            "data_sufficient",
            "preliminary_trend",
            "insufficient_sample"
          ]
        }
      },
      "required": [
        "evidenceId",
        "studentId",
        "date",
        "evidenceType",
        "description"
      ]
    }
  }
}
