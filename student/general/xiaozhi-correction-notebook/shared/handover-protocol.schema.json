{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaozhi-skills.openclaw.dev/schemas/handover-protocol.schema.json",
  "title": "XiaozhiMultiAgentHandoverProtocol",
  "x-distributed-to": "xiaozhi-correction-notebook",
  "x-skill-scope": {
    "note": "本副本随 xiaozhi-correction-notebook 分发，已按其 SKILL.md 裁剪：只保留正文在非否定语境下提到的交接类型（共 4 项，删去 0 个顶层字段）。完整定义在归属技能处。读/写权限与授权位以 SKILL.md 为准。",
    "paths": [
      "wrong_answer_handover",
      "deep_analysis_writeback",
      "profile_writeback",
      "reminder_enqueue"
    ]
  },
  "description": "小智伴学多智能体协作与数据流转协议 (2.1.1)。sender/recipient 覆盖全库 58 个 SKILL；词表以 shared/vocab.md 为唯一来源。",
  "type": "object",
  "properties": {
    "sessionId": {
      "description": "当前会话的唯一ID标识，用于跟踪跨智能体对话流",
      "type": "string"
    },
    "protocolVersion": {
      "description": "协议版本，与仓库版本一致（当前 2.1.12）",
      "type": "string",
      "enum": [
        "2.1.12"
      ]
    },
    "handoverType": {
      "description": "deep_analysis_writeback=学科错误DNA→错题本回写；profile_writeback=写入学习DNA通用层；reminder_enqueue=向IM提醒入队（唯一允许的提醒方式，需 consent.reminderConsent）",
      "type": "string",
      "enum": [
        "wrong_answer_handover",
        "deep_analysis_writeback",
        "profile_writeback",
        "reminder_enqueue"
      ]
    },
    "sender": {
      "description": "发送数据的源SKILL名称",
      "type": "string",
      "enum": [
        "xiaozhi-correction-notebook"
      ]
    },
    "recipient": {
      "description": "接收数据的目标SKILL名称",
      "type": "string",
      "enum": [
        "xiaozhi-im-reminder",
        "xiaozhi-learning-dna",
        "xiaozhi-math-error-dna",
        "xiaozhi-physics-error-dna"
      ]
    },
    "payload": {
      "description": "数据负载主体，结构根据 handoverType 动态变化",
      "type": "object",
      "properties": {
        "wrongAnswerData": {
          "description": "错题交接专属结构。在 handoverType='wrong_answer_handover' 时必填",
          "type": "object",
          "properties": {
            "errorId": {
              "type": "string"
            },
            "subject": {
              "type": "string",
              "enum": [
                "math",
                "physics",
                "chinese",
                "english",
                "other"
              ]
            },
            "concept": {
              "type": "string"
            },
            "handoverTrigger": {
              "type": "string",
              "enum": [
                "new_error",
                "stubborn_weakness",
                "anxiety_trigger"
              ]
            },
            "basicDimension": {
              "type": "string",
              "enum": [
                "概念模糊",
                "计算失误",
                "读题失误",
                "方法用错"
              ],
              "description": "通用四维（shared/vocab.md §1）。所有学科必填"
            },
            "surfaceInfo": {
              "type": "object",
              "properties": {
                "questionAbstract": {
                  "type": "string"
                },
                "studentAnswer": {
                  "type": "string"
                },
                "correctAnswer": {
                  "type": "string"
                },
                "surfaceRootCause": {
                  "type": "string"
                }
              },
              "required": [
                "questionAbstract",
                "studentAnswer",
                "surfaceRootCause"
              ]
            },
            "anxietySignals": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "physicsBasicDimension": {
              "type": "string",
              "enum": [
                "图景建立(P)",
                "概念混淆(C)",
                "公式误用(F)",
                "过程分析错误(R)",
                "数学工具错误(T)"
              ],
              "description": "物理五维（仅 subject=physics 时可用）"
            },
            "judgmentClue": {
              "type": "string"
            },
            "historyRefs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "subtypeId": {
              "type": "string",
              "pattern": "^(RC|AR|WT|CL|LG|[A-Z])[0-9]{2}$",
              "description": "学科子类型编码（shared/vocab.md §2），可选"
            },
            "chineseDimension": {
              "type": "string",
              "enum": [
                "阅读理解(RC)",
                "答题规范(AR)",
                "写作(WT)",
                "文言文(CL)",
                "语病(LG)"
              ],
              "description": "语文五维（仅 subject=chinese 时可用）"
            },
            "englishDimension": {
              "type": "string",
              "enum": [
                "语法(G)",
                "词汇(V)",
                "表达/中式英语(T)",
                "发音(P)",
                "听力(L)"
              ],
              "description": "英语五维（仅 subject=english 时可用）"
            },
            "occurrenceCountInWindow": {
              "type": "integer",
              "minimum": 1,
              "description": "错题本按 shared/vocab.md §5 口径统计的 28 天内累计次数（错题本为唯一计数权威）"
            }
          },
          "required": [
            "errorId",
            "subject",
            "concept",
            "handoverTrigger",
            "basicDimension",
            "surfaceInfo"
          ]
        },
        "profileData": {
          "description": "DNA回写专属结构。handoverType 为 profile_writeback 时必填",
          "type": "object",
          "properties": {
            "updateTarget": {
              "type": "string",
              "enum": [
                "weak_knowledge_points"
              ]
            },
            "weakKnowledgePointUpdates": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "subject": {
                    "type": "string",
                    "maxLength": 20
                  },
                  "knowledgePoint": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "待处理",
                      "初步弱项",
                      "突破中",
                      "顽固弱项",
                      "已攻克"
                    ]
                  },
                  "confidenceLevel": {
                    "type": "string",
                    "enum": [
                      "data_sufficient",
                      "preliminary_trend",
                      "insufficient_sample"
                    ]
                  }
                },
                "required": [
                  "subject",
                  "knowledgePoint",
                  "status"
                ]
              }
            }
          },
          "required": [
            "updateTarget"
          ]
        },
        "reminderData": {
          "description": "提醒专属结构。handoverType 为 reminder_enqueue 时必填",
          "type": "object",
          "properties": {
            "reminderId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "error_review"
              ]
            },
            "scheduledTime": {
              "type": "string",
              "format": "date-time"
            },
            "content": {
              "type": "string"
            },
            "targetKnowledgePoint": {
              "type": "string"
            },
            "priority": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "description": "1 最高。IM提醒按 shared/vocab.md §9 合并为每日摘要"
            },
            "mergeable": {
              "type": "boolean",
              "default": true,
              "description": "是否可并入每日合并摘要；false 表示申请即时提醒（每日最多 1 条）"
            },
            "dueDate": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "reminderId",
            "type",
            "scheduledTime",
            "content"
          ]
        },
        "deepAnalysisData": {
          "type": "object",
          "additionalProperties": false,
          "description": "deep_analysis_writeback 专属：学科错误DNA→错题本回写结构",
          "properties": {
            "errorId": {
              "type": "string",
              "maxLength": 60
            },
            "subject": {
              "type": "string",
              "enum": [
                "math",
                "physics",
                "chinese",
                "english",
                "other"
              ]
            },
            "subtypeId": {
              "type": "string",
              "pattern": "^(RC|AR|WT|CL|LG|[A-Z])[0-9]{2}$"
            },
            "basicDimension": {
              "type": "string",
              "enum": [
                "概念模糊",
                "计算失误",
                "读题失误",
                "方法用错"
              ]
            },
            "rootCause": {
              "type": "string",
              "maxLength": 300,
              "description": "根因一句话，不含原始对话"
            },
            "status": {
              "type": "string",
              "enum": [
                "待处理",
                "初步弱项",
                "突破中",
                "顽固弱项",
                "已攻克"
              ]
            },
            "crackedVerification": {
              "type": "string",
              "maxLength": 200,
              "description": "攻克时的验证方式（shared/vocab.md §5）"
            },
            "recommendedAction": {
              "type": "string",
              "maxLength": 200
            }
          },
          "required": [
            "errorId",
            "subject",
            "basicDimension",
            "status"
          ]
        }
      }
    },
    "timestamp": {
      "description": "ISO-8601格式的时间戳",
      "type": "string",
      "format": "date-time"
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "description": "发送方在发送前核对过的授权位快照（来自 dna-profile meta.consentStatus，见 shared/vocab.md §8）。接收方必须再次核对；任一相关位为 false 时丢弃该交接并告知用户",
      "properties": {
        "crossSkillSharing": {
          "type": "boolean",
          "const": true,
          "description": "跨 SKILL 共享授权。任何交接都必须为 true：为 false 的交接不得发出，接收方收到即丢弃并告知用户（shared/vocab.md §8）"
        },
        "reminderConsent": {
          "type": "boolean",
          "description": "提醒授权。handoverType=reminder_enqueue 时必须为 true"
        },
        "parentSharingConsent": {
          "type": "boolean",
          "description": "允许把学习摘要输出给家长。生成任何家长可见内容前必须核对"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "crossSkillSharing"
      ]
    }
  },
  "required": [
    "sessionId",
    "protocolVersion",
    "handoverType",
    "sender",
    "recipient",
    "consent",
    "payload",
    "timestamp"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "handoverType": {
            "const": "wrong_answer_handover"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "wrongAnswerData"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "handoverType": {
            "const": "deep_analysis_writeback"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "deepAnalysisData"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "handoverType": {
            "enum": [
              "profile_writeback"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "profileData"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "handoverType": {
            "enum": [
              "reminder_enqueue"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "reminderData"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "handoverType": {
            "const": "reminder_enqueue"
          }
        }
      },
      "then": {
        "properties": {
          "consent": {
            "properties": {
              "reminderConsent": {
                "const": true
              }
            },
            "required": [
              "reminderConsent"
            ]
          }
        }
      }
    }
  ]
}
