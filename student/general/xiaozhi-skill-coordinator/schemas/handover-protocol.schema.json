{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XiaozhiMultiAgentHandoverProtocol",
  "description": "小智伴学多智能体协作与数据流转协议 (2.1.1)。sender/recipient 覆盖全库 58 个 SKILL；词表以 shared/vocab.md 为唯一来源。",
  "type": "object",
  "properties": {
    "sessionId": {
      "description": "当前会话的唯一ID标识，用于跟踪跨智能体对话流",
      "type": "string"
    },
    "protocolVersion": {
      "description": "协议版本，与仓库版本一致（当前 2.1.12）",
      "type": "string",
      "enum": [
        "2.1.12"
      ]
    },
    "handoverType": {
      "description": "交接类型：wrong_answer_handover=错题本→学科错误DNA；deep_analysis_writeback=学科错误DNA→错题本回写；profile_writeback=写入学习DNA通用层；subject_profile_writeback=写入学习DNA subjectExtensions/extensions；reminder_enqueue=向IM提醒入队（唯一允许的提醒方式，需 consent.reminderConsent）；reminder_sync=IM提醒回报状态；teacher_writeback=老师端写回学生档案（需 consent.teacherWritebackConsent）",
      "type": "string",
      "enum": [
        "wrong_answer_handover",
        "deep_analysis_writeback",
        "profile_writeback",
        "subject_profile_writeback",
        "reminder_enqueue",
        "reminder_sync",
        "teacher_writeback"
      ]
    },
    "sender": {
      "description": "发送数据的源SKILL名称",
      "type": "string",
      "enum": [
        "xiaozhi-chinese-classical-revival",
        "xiaozhi-chinese-grammar-tracker",
        "xiaozhi-chinese-material-library",
        "xiaozhi-chinese-reading-decoder",
        "xiaozhi-chinese-writing-coach",
        "xiaozhi-english-grammar-coach",
        "xiaozhi-english-listening-trainer",
        "xiaozhi-english-speaking-coach",
        "xiaozhi-english-vocabulary-dna",
        "xiaozhi-english-writing-coach",
        "xiaozhi-cornell-notes",
        "xiaozhi-correction-notebook",
        "xiaozhi-cross-subject-detective",
        "xiaozhi-feynman-learning",
        "xiaozhi-im-reminder",
        "xiaozhi-interest-explorer",
        "xiaozhi-learning-dna",
        "xiaozhi-learning-plan",
        "xiaozhi-skill-coordinator",
        "xiaozhi-time-focus-coach",
        "xiaozhi-weekly-review",
        "xiaozhi-math-concept-explainer",
        "xiaozhi-math-error-dna",
        "xiaozhi-math-gradient-trainer",
        "xiaozhi-math-problem-solving-coach",
        "xiaozhi-math-word-problem-coach",
        "xiaozhi-physics-concept-intuition",
        "xiaozhi-physics-error-dna",
        "xiaozhi-physics-lab-coach",
        "xiaozhi-physics-modeling-coach",
        "xiaozhi-physics-problem-coach",
        "xiaozhi-teach-chinese-classical-guide",
        "xiaozhi-teach-chinese-reading-guide",
        "xiaozhi-teach-chinese-writing-guide",
        "xiaozhi-teach-english-assessment",
        "xiaozhi-teach-english-listening-designer",
        "xiaozhi-teach-english-speaking-designer",
        "xiaozhi-teach-assignment-designer",
        "xiaozhi-teach-classroom-coach",
        "xiaozhi-teach-exam-designer",
        "xiaozhi-teach-lesson-planner",
        "xiaozhi-teach-review-planner",
        "xiaozhi-teach-student-analyzer",
        "xiaozhi-teach-homework-tracker",
        "xiaozhi-teach-lesson-log",
        "xiaozhi-teach-parent-communication",
        "xiaozhi-teach-renewal-report",
        "xiaozhi-teach-resource-library",
        "xiaozhi-teach-schedule-manager",
        "xiaozhi-teach-solo-dashboard",
        "xiaozhi-teach-student-intake",
        "xiaozhi-teach-math-error-analyzer",
        "xiaozhi-teach-math-exam-designer",
        "xiaozhi-teach-math-lesson-planner",
        "xiaozhi-teach-physics-experiment-coach",
        "xiaozhi-teach-physics-lesson-planner",
        "xiaozhi-teach-physics-problem-guide"
      ]
    },
    "recipient": {
      "description": "接收数据的目标SKILL名称",
      "type": "string",
      "enum": [
        "xiaozhi-chinese-classical-revival",
        "xiaozhi-chinese-grammar-tracker",
        "xiaozhi-chinese-material-library",
        "xiaozhi-chinese-reading-decoder",
        "xiaozhi-chinese-writing-coach",
        "xiaozhi-english-grammar-coach",
        "xiaozhi-english-listening-trainer",
        "xiaozhi-english-speaking-coach",
        "xiaozhi-english-vocabulary-dna",
        "xiaozhi-english-writing-coach",
        "xiaozhi-cornell-notes",
        "xiaozhi-correction-notebook",
        "xiaozhi-cross-subject-detective",
        "xiaozhi-feynman-learning",
        "xiaozhi-im-reminder",
        "xiaozhi-interest-explorer",
        "xiaozhi-learning-dna",
        "xiaozhi-learning-plan",
        "xiaozhi-skill-coordinator",
        "xiaozhi-time-focus-coach",
        "xiaozhi-weekly-review",
        "xiaozhi-math-concept-explainer",
        "xiaozhi-math-error-dna",
        "xiaozhi-math-gradient-trainer",
        "xiaozhi-math-problem-solving-coach",
        "xiaozhi-math-word-problem-coach",
        "xiaozhi-physics-concept-intuition",
        "xiaozhi-physics-error-dna",
        "xiaozhi-physics-lab-coach",
        "xiaozhi-physics-modeling-coach",
        "xiaozhi-physics-problem-coach",
        "xiaozhi-teach-chinese-classical-guide",
        "xiaozhi-teach-chinese-reading-guide",
        "xiaozhi-teach-chinese-writing-guide",
        "xiaozhi-teach-english-assessment",
        "xiaozhi-teach-english-listening-designer",
        "xiaozhi-teach-english-speaking-designer",
        "xiaozhi-teach-assignment-designer",
        "xiaozhi-teach-classroom-coach",
        "xiaozhi-teach-exam-designer",
        "xiaozhi-teach-lesson-planner",
        "xiaozhi-teach-review-planner",
        "xiaozhi-teach-student-analyzer",
        "xiaozhi-teach-homework-tracker",
        "xiaozhi-teach-lesson-log",
        "xiaozhi-teach-parent-communication",
        "xiaozhi-teach-renewal-report",
        "xiaozhi-teach-resource-library",
        "xiaozhi-teach-schedule-manager",
        "xiaozhi-teach-solo-dashboard",
        "xiaozhi-teach-student-intake",
        "xiaozhi-teach-math-error-analyzer",
        "xiaozhi-teach-math-exam-designer",
        "xiaozhi-teach-math-lesson-planner",
        "xiaozhi-teach-physics-experiment-coach",
        "xiaozhi-teach-physics-lesson-planner",
        "xiaozhi-teach-physics-problem-guide"
      ]
    },
    "payload": {
      "description": "数据负载主体，结构根据 handoverType 动态变化",
      "type": "object",
      "properties": {
        "wrongAnswerData": {
          "description": "错题交接专属结构。在 handoverType='wrong_answer_handover' 时必填",
          "type": "object",
          "properties": {
            "errorId": {
              "type": "string"
            },
            "subject": {
              "type": "string",
              "enum": [
                "math",
                "physics",
                "chinese",
                "english",
                "other"
              ]
            },
            "concept": {
              "type": "string"
            },
            "handoverTrigger": {
              "type": "string",
              "enum": [
                "new_error",
                "stubborn_weakness",
                "anxiety_trigger"
              ]
            },
            "basicDimension": {
              "type": "string",
              "enum": [
                "概念模糊",
                "计算失误",
                "读题失误",
                "方法用错"
              ],
              "description": "通用四维（shared/vocab.md §1）。所有学科必填"
            },
            "surfaceInfo": {
              "type": "object",
              "properties": {
                "questionAbstract": {
                  "type": "string"
                },
                "studentAnswer": {
                  "type": "string"
                },
                "correctAnswer": {
                  "type": "string"
                },
                "surfaceRootCause": {
                  "type": "string"
                }
              },
              "required": [
                "questionAbstract",
                "studentAnswer",
                "surfaceRootCause"
              ]
            },
            "anxietySignals": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "physicsBasicDimension": {
              "type": "string",
              "enum": [
                "图景建立(P)",
                "概念混淆(C)",
                "公式误用(F)",
                "过程分析错误(R)",
                "数学工具错误(T)"
              ],
              "description": "物理五维（仅 subject=physics 时可用）"
            },
            "judgmentClue": {
              "type": "string"
            },
            "historyRefs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "subtypeId": {
              "type": "string",
              "pattern": "^(RC|AR|WT|CL|LG|[A-Z])[0-9]{2}$",
              "description": "学科子类型编码（shared/vocab.md §2），可选"
            },
            "chineseDimension": {
              "type": "string",
              "enum": [
                "阅读理解(RC)",
                "答题规范(AR)",
                "写作(WT)",
                "文言文(CL)",
                "语病(LG)"
              ],
              "description": "语文五维（仅 subject=chinese 时可用）"
            },
            "englishDimension": {
              "type": "string",
              "enum": [
                "语法(G)",
                "词汇(V)",
                "表达/中式英语(T)",
                "发音(P)",
                "听力(L)"
              ],
              "description": "英语五维（仅 subject=english 时可用）"
            },
            "occurrenceCountInWindow": {
              "type": "integer",
              "minimum": 1,
              "description": "错题本按 shared/vocab.md §5 口径统计的 28 天内累计次数（错题本为唯一计数权威）"
            }
          },
          "required": [
            "errorId",
            "subject",
            "concept",
            "handoverTrigger",
            "basicDimension",
            "surfaceInfo"
          ]
        },
        "profileData": {
          "description": "DNA回写专属结构。handoverType 为 profile_writeback / subject_profile_writeback 时必填",
          "type": "object",
          "properties": {
            "updateTarget": {
              "type": "string",
              "enum": [
                "concept_graph",
                "emotion_dimension",
                "growth_milestones",
                "subject_extension",
                "extension",
                "safety_record",
                "weak_knowledge_points",
                "interest_dna"
              ],
              "description": "interest_dna：兴趣DNA（xiaozhi-interest-explorer 经 profile_writeback 写入 interestDNA，需 interestTrackingConsent）"
            },
            "graphUpdates": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "nodeId": {
                    "type": "string"
                  },
                  "conceptName": {
                    "type": "string"
                  },
                  "subject": {
                    "type": "string"
                  },
                  "masteryLevel": {
                    "type": "string",
                    "enum": [
                      "会复述",
                      "会解释",
                      "真正掌握"
                    ]
                  },
                  "relationships": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "relationType": {
                          "type": "string",
                          "enum": [
                            "requires",
                            "isParentOf",
                            "appliesTo",
                            "correlatesWith"
                          ]
                        },
                        "targetNodeId": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "relationType",
                        "targetNodeId"
                      ]
                    }
                  }
                },
                "required": [
                  "conceptName",
                  "subject",
                  "masteryLevel"
                ]
              }
            },
            "emotionUpdates": {
              "type": "object",
              "properties": {
                "baseline": {
                  "type": "string",
                  "enum": [
                    "积极稳定",
                    "波动中",
                    "低落倾向",
                    "焦虑明显"
                  ]
                },
                "subjectEmotions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "subject": {
                        "type": "string"
                      },
                      "emotionType": {
                        "type": "string",
                        "enum": [
                          "自信愉悦",
                          "平静专注",
                          "紧张但能应对",
                          "焦虑回避",
                          "挫败抗拒"
                        ]
                      }
                    },
                    "required": [
                      "subject",
                      "emotionType"
                    ]
                  }
                }
              }
            },
            "milestone": {
              "type": "object",
              "properties": {
                "milestoneName": {
                  "type": "string"
                },
                "milestoneType": {
                  "type": "string",
                  "enum": [
                    "weakness_solved",
                    "feynman_mastered",
                    "system_health_excellent"
                  ]
                },
                "triggerDate": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "milestoneName",
                "milestoneType"
              ]
            },
            "subjectExtensionPatch": {
              "type": "object",
              "description": "subject_extension 时：dna-profile.schema.json#/properties/subjectExtensions 的单学科分支片段（仅本学科）",
              "additionalProperties": true
            },
            "extensionPatch": {
              "type": "object",
              "description": "extension 时：dna-profile.schema.json#/properties/extensions 的单分支片段",
              "additionalProperties": true
            },
            "safetyRecordEntry": {
              "type": "object",
              "description": "safety_record 时：dna-profile.schema.json#/properties/safetyRecord/crisisReferrals 的单条记录（只记处置事实）",
              "additionalProperties": true
            },
            "weakKnowledgePointUpdates": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "subject": {
                    "type": "string",
                    "maxLength": 20
                  },
                  "knowledgePoint": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "待处理",
                      "初步弱项",
                      "突破中",
                      "顽固弱项",
                      "已攻克"
                    ]
                  },
                  "confidenceLevel": {
                    "type": "string",
                    "enum": [
                      "data_sufficient",
                      "preliminary_trend",
                      "insufficient_sample"
                    ]
                  }
                },
                "required": [
                  "subject",
                  "knowledgePoint",
                  "status"
                ]
              }
            },
            "interestUpdates": {
              "type": "object",
              "description": "updateTarget=interest_dna 时的补丁：只含 interestDNA 下的字段（currentExploringFields / challengeReactionSignals / confirmedShallowLikes / possibleTrueInterests），不得带其他分支。",
              "additionalProperties": true
            }
          },
          "required": [
            "updateTarget"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "updateTarget": {
                    "const": "emotion_dimension"
                  }
                }
              },
              "then": {
                "required": [
                  "emotionUpdates"
                ]
              }
            }
          ]
        },
        "reminderData": {
          "description": "提醒专属结构。handoverType 为 reminder_enqueue / reminder_sync 时必填",
          "type": "object",
          "properties": {
            "reminderId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "spaced_review",
                "error_review",
                "vocab_daily_card",
                "scheduled_task",
                "exploration_task",
                "daily_confirmation",
                "weekly_review",
                "exam_day"
              ]
            },
            "scheduledTime": {
              "type": "string",
              "format": "date-time"
            },
            "content": {
              "type": "string"
            },
            "targetKnowledgePoint": {
              "type": "string"
            },
            "priority": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "description": "1 最高。IM提醒按 shared/vocab.md §9 合并为每日摘要"
            },
            "mergeable": {
              "type": "boolean",
              "default": true,
              "description": "是否可并入每日合并摘要；false 表示申请即时提醒（每日最多 1 条）"
            },
            "dueDate": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "reminderId",
            "type",
            "scheduledTime",
            "content"
          ]
        },
        "deepAnalysisData": {
          "type": "object",
          "additionalProperties": false,
          "description": "deep_analysis_writeback 专属：学科错误DNA→错题本回写结构",
          "properties": {
            "errorId": {
              "type": "string",
              "maxLength": 60
            },
            "subject": {
              "type": "string",
              "enum": [
                "math",
                "physics",
                "chinese",
                "english",
                "other"
              ]
            },
            "subtypeId": {
              "type": "string",
              "pattern": "^(RC|AR|WT|CL|LG|[A-Z])[0-9]{2}$"
            },
            "basicDimension": {
              "type": "string",
              "enum": [
                "概念模糊",
                "计算失误",
                "读题失误",
                "方法用错"
              ]
            },
            "rootCause": {
              "type": "string",
              "maxLength": 300,
              "description": "根因一句话，不含原始对话"
            },
            "status": {
              "type": "string",
              "enum": [
                "待处理",
                "初步弱项",
                "突破中",
                "顽固弱项",
                "已攻克"
              ]
            },
            "crackedVerification": {
              "type": "string",
              "maxLength": 200,
              "description": "攻克时的验证方式（shared/vocab.md §5）"
            },
            "recommendedAction": {
              "type": "string",
              "maxLength": 200
            }
          },
          "required": [
            "errorId",
            "subject",
            "basicDimension",
            "status"
          ]
        },
        "teacherWritebackData": {
          "type": "object",
          "additionalProperties": false,
          "description": "teacher_writeback 专属。接收方必须核对 consent.teacherWritebackConsent=true，否则丢弃并告知",
          "properties": {
            "teacherSkill": {
              "type": "string",
              "enum": [
                "xiaozhi-teach-chinese-classical-guide",
                "xiaozhi-teach-chinese-reading-guide",
                "xiaozhi-teach-chinese-writing-guide",
                "xiaozhi-teach-english-assessment",
                "xiaozhi-teach-english-listening-designer",
                "xiaozhi-teach-english-speaking-designer",
                "xiaozhi-teach-assignment-designer",
                "xiaozhi-teach-classroom-coach",
                "xiaozhi-teach-exam-designer",
                "xiaozhi-teach-lesson-planner",
                "xiaozhi-teach-review-planner",
                "xiaozhi-teach-student-analyzer",
                "xiaozhi-teach-homework-tracker",
                "xiaozhi-teach-lesson-log",
                "xiaozhi-teach-parent-communication",
                "xiaozhi-teach-renewal-report",
                "xiaozhi-teach-resource-library",
                "xiaozhi-teach-schedule-manager",
                "xiaozhi-teach-solo-dashboard",
                "xiaozhi-teach-student-intake",
                "xiaozhi-teach-math-error-analyzer",
                "xiaozhi-teach-math-exam-designer",
                "xiaozhi-teach-math-lesson-planner",
                "xiaozhi-teach-physics-experiment-coach",
                "xiaozhi-teach-physics-lesson-planner",
                "xiaozhi-teach-physics-problem-guide"
              ]
            },
            "studentAlias": {
              "type": "string",
              "maxLength": 40
            },
            "weakKnowledgePointUpdates": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "subject": {
                    "type": "string",
                    "maxLength": 20
                  },
                  "knowledgePoint": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "待处理",
                      "初步弱项",
                      "突破中",
                      "顽固弱项",
                      "已攻克"
                    ]
                  },
                  "masteryLevel": {
                    "type": "string",
                    "enum": [
                      "会复述",
                      "会解释",
                      "真正掌握"
                    ]
                  }
                },
                "required": [
                  "subject",
                  "knowledgePoint"
                ]
              }
            },
            "note": {
              "type": "string",
              "maxLength": 200,
              "description": "低敏事实描述；禁止心理标签、家庭信息、真实姓名"
            }
          },
          "required": [
            "teacherSkill"
          ]
        }
      }
    },
    "timestamp": {
      "description": "ISO-8601格式的时间戳",
      "type": "string",
      "format": "date-time"
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "description": "发送方在发送前核对过的授权位快照（来自 dna-profile meta.consentStatus，见 shared/vocab.md §8）。接收方必须再次核对；任一相关位为 false 时丢弃该交接并告知用户",
      "properties": {
        "crossSkillSharing": {
          "type": "boolean",
          "const": true,
          "description": "跨 SKILL 共享授权。任何交接都必须为 true：为 false 的交接不得发出，接收方收到即丢弃并告知用户（shared/vocab.md §8）"
        },
        "emotionTrackingConsent": {
          "type": "boolean",
          "description": "情绪数据记录授权。updateTarget=emotion_dimension 时必须为 true"
        },
        "teacherWritebackConsent": {
          "type": "boolean"
        },
        "reminderConsent": {
          "type": "boolean",
          "description": "提醒授权。handoverType=reminder_enqueue 时必须为 true"
        },
        "interestTrackingConsent": {
          "type": "boolean",
          "description": "兴趣DNA写入授权。updateTarget=interest_dna 时必须为 true"
