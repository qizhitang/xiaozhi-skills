{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaozhi-skills.openclaw.dev/schemas/handover-protocol.schema.json",
  "title": "XiaozhiMultiAgentHandoverProtocol",
  "x-distributed-to": "xiaozhi-learning-dna",
  "x-skill-scope": {
    "note": "本副本随 xiaozhi-learning-dna 分发，已按其 SKILL.md 裁剪：只保留正文在非否定语境下提到的交接类型（共 3 项，删去 0 个顶层字段）。完整定义在归属技能处。读/写权限与授权位以 SKILL.md 为准。本技能是接收方：sender 为各写入方，recipient 为自己；保留全部写回目标与字段以校验来件。",
    "paths": [
      "profile_writeback",
      "subject_profile_writeback",
      "teacher_writeback"
    ]
  },
  "description": "小智伴学多智能体协作与数据流转协议 (2.1.1)。sender/recipient 覆盖全库 58 个 SKILL；词表以 shared/vocab.md 为唯一来源。",
  "type": "object",
  "properties": {
    "sessionId": {
      "description": "当前会话的唯一ID标识，用于跟踪跨智能体对话流",
      "type": "string"
    },
    "protocolVersion": {
      "description": "协议版本，与仓库版本一致（当前 2.1.12）",
      "type": "string",
      "enum": [
        "2.1.12"
      ]
    },
    "handoverType": {
      "description": "profile_writeback=写入学习DNA通用层；subject_profile_writeback=写入学习DNA subjectExtensions/extensions；teacher_writeback=老师端写回学生档案（需 consent.teacherWritebackConsent）",
      "type": "string",
      "enum": [
        "profile_writeback",
        "subject_profile_writeback",
        "teacher_writeback"
      ]
    },
    "sender": {
      "description": "发送数据的源SKILL名称",
      "type": "string",
      "enum": [
        "xiaozhi-chinese-classical-revival",
        "xiaozhi-chinese-grammar-tracker",
        "xiaozhi-chinese-material-library",
        "xiaozhi-chinese-reading-decoder",
        "xiaozhi-chinese-writing-coach",
        "xiaozhi-english-grammar-coach",
        "xiaozhi-english-listening-trainer",
        "xiaozhi-english-speaking-coach",
        "xiaozhi-english-vocabulary-dna",
        "xiaozhi-english-writing-coach",
        "xiaozhi-cornell-notes",
        "xiaozhi-correction-notebook",
        "xiaozhi-cross-subject-detective",
        "xiaozhi-feynman-learning",
        "xiaozhi-im-reminder",
        "xiaozhi-interest-explorer",
        "xiaozhi-learning-plan",
        "xiaozhi-skill-coordinator",
        "xiaozhi-time-focus-coach",
        "xiaozhi-weekly-review",
        "xiaozhi-math-concept-explainer",
        "xiaozhi-math-error-dna",
        "xiaozhi-math-gradient-trainer",
        "xiaozhi-math-problem-solving-coach",
        "xiaozhi-math-word-problem-coach",
        "xiaozhi-physics-concept-intuition",
        "xiaozhi-physics-error-dna",
        "xiaozhi-physics-lab-coach",
        "xiaozhi-physics-modeling-coach",
        "xiaozhi-physics-problem-coach",
        "xiaozhi-teach-chinese-classical-guide",
        "xiaozhi-teach-chinese-reading-guide",
        "xiaozhi-teach-chinese-writing-guide",
        "xiaozhi-teach-english-assessment",
        "xiaozhi-teach-english-listening-designer",
        "xiaozhi-teach-english-speaking-designer",
        "xiaozhi-teach-assignment-designer",
        "xiaozhi-teach-classroom-coach",
        "xiaozhi-teach-exam-designer",
        "xiaozhi-teach-lesson-planner",
        "xiaozhi-teach-review-planner",
        "xiaozhi-teach-student-analyzer",
        "xiaozhi-teach-homework-tracker",
        "xiaozhi-teach-lesson-log",
        "xiaozhi-teach-parent-communication",
        "xiaozhi-teach-renewal-report",
        "xiaozhi-teach-resource-library",
        "xiaozhi-teach-schedule-manager",
        "xiaozhi-teach-solo-dashboard",
        "xiaozhi-teach-student-intake",
        "xiaozhi-teach-math-error-analyzer",
        "xiaozhi-teach-math-exam-designer",
        "xiaozhi-teach-math-lesson-planner",
        "xiaozhi-teach-physics-experiment-coach",
        "xiaozhi-teach-physics-lesson-planner",
        "xiaozhi-teach-physics-problem-guide"
      ]
    },
    "recipient": {
      "description": "接收数据的目标SKILL名称",
      "type": "string",
      "enum": [
        "xiaozhi-learning-dna"
      ]
    },
    "payload": {
      "description": "数据负载主体，结构根据 handoverType 动态变化",
      "type": "object",
      "properties": {
        "profileData": {
          "description": "DNA回写专属结构。handoverType 为 profile_writeback / subject_profile_writeback 时必填",
          "type": "object",
          "properties": {
            "updateTarget": {
              "type": "string",
              "enum": [
                "concept_graph",
                "emotion_dimension",
                "growth_milestones",
                "subject_extension",
                "extension",
                "weak_knowledge_points",
                "interest_dna"
              ],
              "description": "interest_dna：兴趣DNA（xiaozhi-interest-explorer 经 profile_writeback 写入 interestDNA，需 interestTrackingConsent）"
            },
            "graphUpdates": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "nodeId": {
                    "type": "string"
                  },
                  "conceptName": {
                    "type": "string"
                  },
                  "subject": {
                    "type": "string"
                  },
                  "masteryLevel": {
                    "type": "string",
                    "enum": [
                      "会复述",
                      "会解释",
                      "真正掌握"
                    ]
                  },
                  "relationships": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "relationType": {
                          "type": "string",
                          "enum": [
                            "requires",
                            "isParentOf",
                            "appliesTo",
                            "correlatesWith"
                          ]
                        },
                        "targetNodeId": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "relationType",
                        "targetNodeId"
                      ]
                    }
                  }
                },
                "required": [
                  "conceptName",
                  "subject",
                  "masteryLevel"
                ]
              }
            },
            "emotionUpdates": {
              "type": "object",
              "properties": {
                "baseline": {
                  "type": "string",
                  "enum": [
                    "积极稳定",
                    "波动中",
                    "低落倾向",
                    "焦虑明显"
                  ]
                },
                "subjectEmotions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "subject": {
                        "type": "string"
                      },
                      "emotionType": {
                        "type": "string",
                        "enum": [
                          "自信愉悦",
                          "平静专注",
                          "紧张但能应对",
                          "焦虑回避",
                          "挫败抗拒"
                        ]
                      }
                    },
                    "required": [
                      "subject",
                      "emotionType"
                    ]
                  }
                }
              }
            },
            "milestone": {
              "type": "object",
              "properties": {
                "milestoneName": {
                  "type": "string"
                },
                "milestoneType": {
                  "type": "string",
                  "enum": [
                    "weakness_solved",
                    "feynman_mastered",
                    "system_health_excellent"
                  ]
                },
                "triggerDate": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "milestoneName",
                "milestoneType"
              ]
            },
            "subjectExtensionPatch": {
              "type": "object",
              "description": "subject_extension 时：dna-profile.schema.json#/properties/subjectExtensions 的单学科分支片段（仅本学科）",
              "additionalProperties": true
            },
            "extensionPatch": {
              "type": "object",
              "description": "extension 时：只允许写 extensions.notes、extensions.focus、extensions.plans、extensions.projects、extensions.understanding",
              "properties": {
                "notes": {
                  "type": "object"
                },
                "focus": {
                  "type": "object"
                },
                "plans": {
                  "type": "object"
                },
                "projects": {
                  "type": "object"
                },
                "understanding": {
                  "type": "object"
                }
              },
              "additionalProperties": false
            },
            "weakKnowledgePointUpdates": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "subject": {
                    "type": "string",
                    "maxLength": 20
                  },
                  "knowledgePoint": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "待处理",
                      "初步弱项",
                      "突破中",
                      "顽固弱项",
                      "已攻克"
                    ]
                  },
                  "confidenceLevel": {
                    "type": "string",
                    "enum": [
                      "data_sufficient",
                      "preliminary_trend",
                      "insufficient_sample"
                    ]
                  }
                },
                "required": [
                  "subject",
                  "knowledgePoint",
                  "status"
                ]
              }
            },
            "interestUpdates": {
              "type": "object",
              "description": "updateTarget=interest_dna 时的补丁：只含 interestDNA 下的字段（currentExploringFields / challengeReactionSignals / confirmedShallowLikes / possibleTrueInterests），不得带其他分支。",
              "additionalProperties": true
            }
          },
          "required": [
            "updateTarget"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "updateTarget": {
                    "const": "emotion_dimension"
                  }
                }
              },
              "then": {
                "required": [
                  "emotionUpdates"
                ]
              }
            }
          ]
        },
        "teacherWritebackData": {
          "type": "object",
          "additionalProperties": false,
          "description": "teacher_writeback 专属。接收方必须核对 consent.teacherWritebackConsent=true，否则丢弃并告知",
          "properties": {
            "teacherSkill": {
              "type": "string",
              "enum": [
                "xiaozhi-teach-chinese-classical-guide",
                "xiaozhi-teach-chinese-reading-guide",
                "xiaozhi-teach-chinese-writing-guide",
                "xiaozhi-teach-english-assessment",
                "xiaozhi-teach-english-listening-designer",
                "xiaozhi-teach-english-speaking-designer",
                "xiaozhi-teach-assignment-designer",
                "xiaozhi-teach-classroom-coach",
                "xiaozhi-teach-exam-designer",
                "xiaozhi-teach-lesson-planner",
                "xiaozhi-teach-review-planner",
                "xiaozhi-teach-student-analyzer",
                "xiaozhi-teach-homework-tracker",
                "xiaozhi-teach-lesson-log",
                "xiaozhi-teach-parent-communication",
                "xiaozhi-teach-renewal-report",
                "xiaozhi-teach-resource-library",
                "xiaozhi-teach-schedule-manager",
                "xiaozhi-teach-solo-dashboard",
                "xiaozhi-teach-student-intake",
                "xiaozhi-teach-math-error-analyzer",
                "xiaozhi-teach-math-exam-designer",
                "xiaozhi-teach-math-lesson-planner",
                "xiaozhi-teach-physics-experiment-coach",
                "xiaozhi-teach-physics-lesson-planner",
                "xiaozhi-teach-physics-problem-guide"
              ]
            },
            "studentAlias": {
              "type": "string",
              "maxLength": 40
            },
            "weakKnowledgePointUpdates": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "subject": {
                    "type": "string",
                    "maxLength": 20
                  },
                  "knowledgePoint": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "待处理",
                      "初步弱项",
                      "突破中",
                      "顽固弱项",
                      "已攻克"
                    ]
                  },
                  "masteryLevel": {
                    "type": "string",
                    "enum": [
                      "会复述",
                      "会解释",
                      "真正掌握"
                    ]
                  }
                },
                "required": [
                  "subject",
                  "knowledgePoint"
                ]
              }
            },
            "note": {
              "type": "string",
              "maxLength": 200,
              "description": "低敏事实描述；禁止心理标签、家庭信息、真实姓名"
            }
          },
          "required": [
            "teacherSkill"
          ]
        }
      }
    },
    "timestamp": {
      "description": "ISO-8601格式的时间戳",
      "type": "string",
      "format": "date-time"
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "description": "发送方在发送前核对过的授权位快照（来自 dna-profile meta.consentStatus，见 shared/vocab.md §8）。接收方必须再次核对；任一相关位为 false 时丢弃该交接并告知用户",
      "properties": {
        "crossSkillSharing": {
          "type": "boolean",
          "const": true,
          "description": "跨 SKILL 共享授权。任何交接都必须为 true：为 false 的交接不得发出，接收方收到即丢弃并告知用户（shared/vocab.md §8）"
        },
        "emotionTrackingConsent": {
          "type": "boolean",
          "description": "情绪数据记录授权。updateTarget=emotion_dimension 时必须为 true"
        },
        "teacherWritebackConsent": {
          "type": "boolean"
        },
        "interestTrackingConsent": {
          "type": "boolean",
          "description": "兴趣DNA写入授权。updateTarget=interest_dna 时必须为 true"
        },
        "parentSharingConsent": {
          "type": "boolean",
          "description": "允许把学习摘要输出给家长。生成任何家长可见内容前必须核对"
        },
        "emotionSharingWithParent": {
          "type": "boolean",
          "description": "允许把情绪相关内容输出给家长。独立于 parentSharingConsent，必须学生本人同意"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "crossSkillSharing"
      ]
    }
  },
  "required": [
    "sessionId",
    "protocolVersion",
    "handoverType",
    "sender",
    "recipient",
    "consent",
    "payload",
    "timestamp"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "handoverType": {
            "enum": [
              "profile_writeback",
              "subject_profile_writeback"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "profileData"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "handoverType": {
            "const": "teacher_writeback"
          }
        }
      },
      "then": {
        "properties": {
          "consent": {
            "properties": {
              "teacherWritebackConsent": {
                "const": true
              }
            },
            "required": [
              "teacherWritebackConsent"
            ]
          },
          "payload": {
            "required": [
              "teacherWritebackData"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "payload"
        ],
        "properties": {
          "payload": {
            "required": [
              "profileData"
            ],
            "properties": {
              "profileData": {
                "required": [
                  "updateTarget"
                ],
                "properties": {
                  "updateTarget": {
                    "const": "emotion_dimension"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "consent": {
            "properties": {
              "emotionTrackingConsent": {
                "const": true
              }
            },
            "required": [
              "emotionTrackingConsent"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "payload"
        ],
        "properties": {
          "payload": {
            "required": [
              "profileData"
            ],
            "properties": {
              "profileData": {
                "required": [
                  "updateTarget"
                ],
                "properties": {
                  "updateTarget": {
                    "const": "interest_dna"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "consent": {
            "properties": {
              "interestTrackingConsent": {
                "const": true
              }
            },
            "required": [
              "interestTrackingConsent"
            ]
          }
        }
      }
    }
  ]
}
