{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaozhi-skills.openclaw.dev/schemas/dna-profile.schema.json",
  "title": "LearningDNAProfile",
  "x-distributed-to": "xiaozhi-feynman-learning",
  "x-skill-scope": {
    "note": "本副本随 xiaozhi-feynman-learning 分发，已按其 SKILL.md 裁剪：只保留正文在非否定语境下提到的字段（共 1 项，删去 12 个顶层字段）。完整定义在归属技能处。读/写权限与授权位以 SKILL.md 为准。",
    "paths": [
      "extensions.understanding"
    ]
  },
  "description": "学习DNA —— 小智长期记忆核心引擎的数据结构定义。覆盖六大基础维度（基础信息、学科强弱、学习风格、错误模式、对话摘要、成长轨迹）、成长图谱与兴趣DNA、学习情绪，以及授权主体与学段、学科扩展档案 subjectExtensions、通用扩展档案 extensions、安全处置记录 safetyRecord。所有词表以 shared/vocab.md 为唯一来源。所有字段均为可选，默认只记录完成个性化辅导所必需的最小信息。本 schema 由 xiaozhi-learning-dna 定义并保管，它本身不产生错因、理解、情绪等判断，这些维度由对应技能经 handover 在授权后写入。其他技能随包附带的副本仅供字段名参照：各技能实际可读写的路径以副本顶部的 x-skill-scope 与其 SKILL.md 接口节为准。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "description": "通用扩展档案：notes 由康奈尔笔记写入，focus 由时间与专注力教练写入，plans 由 30 天学习计划制定师写入，projects 由跨学科侦探周写入，understanding 由费曼学习法写入。各分支只由对应 SKILL 写入，写入一律经 handover 的 subject_profile_writeback",
      "properties": {
        "understanding": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "concept": {
                "type": "string",
                "maxLength": 100
              },
              "subject": {
                "type": "string",
                "maxLength": 20
              },
              "depth": {
                "$ref": "#/$defs/masteryLevel"
              },
              "stuckAt": {
                "type": "string",
                "maxLength": 100,
                "description": "费曼卡住的位置，不写原话"
              },
              "lastTestedDate": {
                "type": "string",
                "format": "date"
              },
              "nextSuggestion": {
                "type": "string",
                "maxLength": 100
              }
            },
            "required": [
              "concept",
              "depth"
            ]
          }
        }
      }
    }
  },
  "required": [],
  "$defs": {
    "confidenceLevel": {
      "description": "结论置信度标签（shared/vocab.md §7）：防止数据不足时给出误导性结论。样本不足（insufficient_sample）只作输出标签，不可写入本档案，故不在枚举内。凡是基于'连续N次'得出的AI结论必须附带此标签。data_sufficient=🟢数据充分（≥3 次独立观察且方向一致）；preliminary_trend=🟡初步趋势（2 次观察或方向基本一致）；insufficient_sample=🔴样本不足（单次观察或互相矛盾，不写入长期档案）",
      "type": "string",
      "enum": [
        "data_sufficient",
        "preliminary_trend"
      ]
    },
    "subjectEntry": {
      "description": "学科条目：用于强项和弱项列表",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject": {
          "type": "string",
          "description": "学科名称",
          "examples": [
            "语文",
            "数学",
            "英语",
            "物理",
            "化学",
            "生物",
            "历史",
            "地理",
            "政治"
          ]
        },
        "chapters": {
          "type": "array",
          "description": "具体章节或知识点",
          "items": {
            "type": "string"
          }
        },
        "rootCause": {
          "type": "string",
          "description": "薄弱的根本原因（仅弱项使用）"
        },
        "confidenceLevel": {
          "$ref": "#/$defs/confidenceLevel"
        }
      },
      "required": [
        "subject"
      ]
    },
    "errorDimension": {
      "type": "string",
      "enum": [
        "概念模糊",
        "计算失误",
        "读题失误",
        "方法用错"
      ],
      "description": "错因基础四维（shared/vocab.md §1）。学科子类型见 subtypeId"
    },
    "weaknessStatus": {
      "type": "string",
      "enum": [
        "待处理",
        "初步弱项",
        "突破中",
        "顽固弱项",
        "已攻克"
      ],
      "description": "弱项状态五档（shared/vocab.md §4）"
    },
    "masteryLevel": {
      "type": "string",
      "enum": [
        "会复述",
        "会解释",
        "真正掌握"
      ],
      "description": "掌握度三档（shared/vocab.md §6）"
    },
    "ageBand": {
      "type": "string",
      "enum": [
        "小学低段",
        "小学中段",
        "小学高段",
        "初中",
        "高中",
        "未知"
      ],
      "description": "学段（shared/vocab.md §10）"
    },
    "subtypeRecord": {
      "type": "object",
      "additionalProperties": false,
      "description": "学科子类型记录（shared/vocab.md §2）。通用层只存 ID，不解释含义",
      "properties": {
        "subtypeId": {
          "type": "string",
          "pattern": "^(RC|AR|WT|CL|LG|[A-Z])[0-9]{2}$",
          "description": "学科子类型编码，如 B03 / P02 / G05 / RC01"
        },
        "dimension": {
          "$ref": "#/$defs/errorDimension"
        },
        "knowledgePoint": {
          "type": "string",
          "maxLength": 100
        },
        "occurrenceCount": {
          "type": "integer",
          "minimum": 0
        },
        "windowStart": {
          "type": "string",
          "format": "date",
          "description": "28 天滚动窗口起点（shared/vocab.md §5）"
        },
        "status": {
          "$ref": "#/$defs/weaknessStatus"
        },
        "lastOccurrenceDate": {
          "type": "string",
          "format": "date"
        },
        "confidenceLevel": {
          "$ref": "#/$defs/confidenceLevel"
        }
      },
      "required": [
        "subtypeId",
        "knowledgePoint",
        "status"
      ]
    },
    "subjectSubtypeMap": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/subtypeRecord"
      }
    }
  }
}
