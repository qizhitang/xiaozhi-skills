{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaozhi-skills.openclaw.dev/schemas/dna-profile.schema.json",
  "title": "LearningDNAProfile",
  "x-distributed-to": "xiaozhi-chinese-grammar-tracker",
  "x-skill-scope": {
    "note": "本副本随 xiaozhi-chinese-grammar-tracker 分发，已按其 SKILL.md 裁剪：只保留正文在非否定语境下提到的字段（共 2 项，删去 11 个顶层字段）。完整定义在归属技能处。读/写权限与授权位以 SKILL.md 为准。",
    "paths": [
      "meta",
      "subjectExtensions.chinese"
    ]
  },
  "description": "学习DNA —— 小智长期记忆核心引擎的数据结构定义。覆盖六大基础维度（基础信息、学科强弱、学习风格、错误模式、对话摘要、成长轨迹）、成长图谱与兴趣DNA、学习情绪，以及授权主体与学段、学科扩展档案 subjectExtensions、通用扩展档案 extensions、安全处置记录 safetyRecord。所有词表以 shared/vocab.md 为唯一来源。所有字段均为可选，默认只记录完成个性化辅导所必需的最小信息。本 schema 由 xiaozhi-learning-dna 定义并保管，错因、理解深度由对应技能经 handover 在授权后写入；学习情绪维度与成长里程碑由 xiaozhi-learning-dna 自己在各自授权位开启后产出。其他技能随包附带的副本仅供字段名参照：各技能实际可读写的路径以副本顶部的 x-skill-scope 与其 SKILL.md 接口节为准。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "meta": {
      "description": "档案元数据：版本、创建时间、授权状态",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profileId": {
          "type": "string",
          "description": "档案唯一标识符，由平台自动生成",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "schemaVersion": {
          "type": "string",
          "description": "档案结构版本号，与仓库版本一致（当前 2.1.7）。旧档案（1.0.0–1.3.0）的字段在本结构中全部保留且均为可选，迁移时只需把本字段改写为 2.1.0。",
          "enum": [
            "2.1.7"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "首次建档时间（ISO 8601）"
        },
        "lastUpdatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "最近一次更新时间（ISO 8601）"
        },
        "consentStatus": {
          "description": "授权状态：用户对长期档案的当前授权情况",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profileEnabled": {
              "type": "boolean",
              "description": "用户是否已同意开启长期档案",
              "default": false
            },
            "memoryPaused": {
              "type": "boolean",
              "description": "是否暂停记忆（本次不读取也不写入）",
              "default": false
            },
            "crossSkillSharing": {
              "type": "boolean",
              "description": "是否允许跨SKILL共享最小字段摘要",
              "default": false
            },
            "reminderConsent": {
              "type": "boolean",
              "description": "是否同意接收IM提醒",
              "default": false
            },
            "interestTrackingConsent": {
              "type": "boolean",
              "description": "是否同意记录兴趣偏好",
              "default": false
            },
            "emotionTrackingConsent": {
              "type": "boolean",
              "description": "是否同意记录学习情绪数据（默认关闭，需单独授权）",
              "default": false
            },
            "consentGivenBy": {
              "type": "string",
              "enum": [
                "学生本人",
                "监护人",
                "学生与监护人",
                "未记录"
              ],
              "default": "未记录",
              "description": "同意主体（shared/vocab.md §8）。profileEnabled=true 时应为 学生本人/监护人/学生与监护人；ageBand 为小学各段时必须包含监护人"
            },
            "ageBand": {
              "$ref": "#/$defs/ageBand",
              "description": "学段（shared/vocab.md §10），用于推导 guardianConsentRequired 与学段参数"
            },
            "guardianConsentRequired": {
              "type": "boolean",
              "default": false,
              "description": "是否需要监护人同意（小学各段为 true；初中由 SKILL 询问年龄后判断，约 ≤14 周岁为 true）"
            },
            "parentSharingConsent": {
              "type": "boolean",
              "default": false,
              "description": "允许把学习摘要输出给家长/监护人（家庭看板、月报家长页、家长简报）。默认 false"
            },
            "emotionSharingWithParent": {
              "type": "boolean",
              "default": false,
              "description": "允许把情绪相关内容输出给家长。独立于 parentSharingConsent，必须学生本人同意。默认 false。危机例外（shared/crisis-exception.md）不受此位限制"
            },
            "teacherWritebackConsent": {
              "type": "boolean",
              "default": false,
              "description": "允许老师端 SKILL 写回本档案。默认 false"
            },
            "grantedAt": {
              "type": "string",
              "format": "date-time",
              "description": "最近一次授权变更时间"
            },
            "lastReviewedAt": {
              "type": "string",
              "format": "date-time",
              "description": "最近一次向用户复述授权状态的时间（建议每学期一次）"
            }
          }
        }
      },
      "required": [
        "profileId",
        "schemaVersion",
        "createdAt",
        "consentStatus"
      ]
    },
    "subjectExtensions": {
      "type": "object",
      "additionalProperties": false,
      "description": "学科扩展档案。每个学科 SKILL 只读写本学科分支（数学 SKILL 只写 math，物理只写 physics，语文只写 chinese，英语只写 english），且受 consentStatus.crossSkillSharing 约束。写入一律经 handover 的 subject_profile_writeback",
      "properties": {
        "chinese": {
          "type": "object",
          "additionalProperties": false,
          "description": "语文五个学生端 SKILL 的学科层档案（语病档案、写作风格、阅读五坑、素材使用、文言进度）",
          "properties": {
            "subtypes": {
              "$ref": "#/$defs/subjectSubtypeMap"
            },
            "grammarErrorProfile": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "errorType": {
                    "type": "string",
                    "enum": [
                      "搭配不当",
                      "成分残缺",
                      "语序不当",
                      "结构混乱",
                      "表意不明",
                      "不合逻辑",
                      "赘余"
                    ]
                  },
                  "occurrenceCount": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "status": {
                    "$ref": "#/$defs/weaknessStatus"
                  },
                  "lastDate": {
                    "type": "string",
                    "format": "date"
                  }
                },
                "required": [
                  "errorType",
                  "status"
                ]
              }
            },
            "writingStyle": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "strengths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 60
                  }
                },
                "recurringIssues": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 60
                  }
                },
                "preferredGenre": {
                  "type": "string",
                  "maxLength": 30
                },
                "lastUpdated": {
                  "type": "string",
                  "format": "date"
                },
                "confidenceLevel": {
                  "$ref": "#/$defs/confidenceLevel"
                }
              }
            },
            "readingPits": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "pit": {
                    "type": "string",
                    "maxLength": 30,
                    "description": "五坑之一的名称"
                  },
                  "status": {
                    "$ref": "#/$defs/weaknessStatus"
                  },
                  "lastDate": {
                    "type": "string",
                    "format": "date"
                  }
                },
                "required": [
                  "pit",
                  "status"
                ]
              }
            },
            "materialUsage": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "materialId": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "usedInWriting": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "lastUsed": {
                    "type": "string",
                    "format": "date"
                  }
                },
                "required": [
                  "materialId"
                ]
              }
            },
            "classicalProgress": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "type": "string",
                    "maxLength": 60,
                    "description": "篇目名"
                  },
                  "stage": {
                    "type": "string",
                    "enum": [
                      "能读通",
                      "能翻译",
                      "能背诵",
                      "能鉴赏"
                    ]
                  },
                  "lastDate": {
                    "type": "string",
                    "format": "date"
                  }
                },
                "required": [
                  "text",
                  "stage"
                ]
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "meta"
  ],
  "$defs": {
    "confidenceLevel": {
      "description": "结论置信度标签（shared/vocab.md §7）：防止数据不足时给出误导性结论。样本不足（insufficient_sample）只作输出标签，不可写入本档案，故不在枚举内。凡是基于'连续N次'得出的AI结论必须附带此标签。data_sufficient=🟢数据充分（≥3 次独立观察且方向一致）；preliminary_trend=🟡初步趋势（2 次观察或方向基本一致）；insufficient_sample=🔴样本不足（单次观察或互相矛盾，不写入长期档案）",
      "type": "string",
      "enum": [
        "data_sufficient",
        "preliminary_trend"
      ]
    },
    "subjectEntry": {
      "description": "学科条目：用于强项和弱项列表",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject": {
          "type": "string",
          "description": "学科名称",
          "examples": [
            "语文",
            "数学",
            "英语",
            "物理",
            "化学",
            "生物",
            "历史",
            "地理",
            "政治"
          ]
        },
        "chapters": {
          "type": "array",
          "description": "具体章节或知识点",
          "items": {
            "type": "string"
          }
        },
        "rootCause": {
          "type": "string",
          "description": "薄弱的根本原因（仅弱项使用）"
        },
        "confidenceLevel": {
          "$ref": "#/$defs/confidenceLevel"
        }
      },
      "required": [
        "subject"
      ]
    },
    "errorDimension": {
      "type": "string",
      "enum": [
        "概念模糊",
        "计算失误",
        "读题失误",
        "方法用错"
      ],
      "description": "错因基础四维（shared/vocab.md §1）。学科子类型见 subtypeId"
    },
    "weaknessStatus": {
      "type": "string",
      "enum": [
        "待处理",
        "初步弱项",
        "突破中",
        "顽固弱项",
        "已攻克"
      ],
      "description": "弱项状态五档（shared/vocab.md §4）"
    },
    "masteryLevel": {
      "type": "string",
      "enum": [
        "会复述",
        "会解释",
        "真正掌握"
      ],
      "description": "掌握度三档（shared/vocab.md §6）"
    },
    "ageBand": {
      "type": "string",
      "enum": [
        "小学低段",
        "小学中段",
        "小学高段",
        "初中",
        "高中",
        "未知"
      ],
      "description": "学段（shared/vocab.md §10）"
    },
    "subtypeRecord": {
      "type": "object",
      "additionalProperties": false,
      "description": "学科子类型记录（shared/vocab.md §2）。通用层只存 ID，不解释含义",
      "properties": {
        "subtypeId": {
          "type": "string",
          "pattern": "^(RC|AR|WT|CL|LG|[A-Z])[0-9]{2}$",
          "description": "学科子类型编码，如 B03 / P02 / G05 / RC01"
        },
        "dimension": {
          "$ref": "#/$defs/errorDimension"
        },
        "knowledgePoint": {
          "type": "string",
          "maxLength": 100
        },
        "occurrenceCount": {
          "type": "integer",
          "minimum": 0
        },
        "windowStart": {
          "type": "string",
          "format": "date",
          "description": "28 天滚动窗口起点（shared/vocab.md §5）"
        },
        "status": {
          "$ref": "#/$defs/weaknessStatus"
        },
        "lastOccurrenceDate": {
          "type": "string",
          "format": "date"
        },
        "confidenceLevel": {
          "$ref": "#/$defs/confidenceLevel"
        }
      },
      "required": [
        "subtypeId",
        "knowledgePoint",
        "status"
      ]
    },
    "subjectSubtypeMap": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/subtypeRecord"
      }
    }
  }
}
