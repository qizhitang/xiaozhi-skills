{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaozhi-skills.openclaw.dev/schemas/handover-protocol.schema.json",
  "title": "XiaozhiMultiAgentHandoverProtocol",
  "x-distributed-to": "xiaozhi-chinese-reading-decoder",
  "x-skill-scope": {
    "note": "本副本随 xiaozhi-chinese-reading-decoder 分发，已按其 SKILL.md 裁剪：只保留正文在非否定语境下提到的交接类型（共 1 项，删去 0 个顶层字段）。完整定义在归属技能处。读/写权限与授权位以 SKILL.md 为准。",
    "paths": [
      "subject_profile_writeback"
    ]
  },
  "description": "小智伴学多智能体协作与数据流转协议 (2.1.1)。sender/recipient 覆盖全库 58 个 SKILL；词表以 shared/vocab.md 为唯一来源。",
  "type": "object",
  "properties": {
    "sessionId": {
      "description": "当前会话的唯一ID标识，用于跟踪跨智能体对话流",
      "type": "string"
    },
    "protocolVersion": {
      "description": "协议版本，与仓库版本一致（当前 2.1.10）",
      "type": "string",
      "enum": [
        "2.1.10"
      ]
    },
    "handoverType": {
      "description": "subject_profile_writeback=写入学习DNA subjectExtensions/extensions",
      "type": "string",
      "enum": [
        "subject_profile_writeback"
      ]
    },
    "sender": {
      "description": "发送数据的源SKILL名称",
      "type": "string",
      "enum": [
        "xiaozhi-chinese-reading-decoder"
      ]
    },
    "recipient": {
      "description": "接收数据的目标SKILL名称",
      "type": "string",
      "enum": [
        "xiaozhi-learning-dna"
      ]
    },
    "payload": {
      "description": "数据负载主体，结构根据 handoverType 动态变化",
      "type": "object",
      "properties": {
        "profileData": {
          "description": "DNA回写专属结构。handoverType 为 subject_profile_writeback 时必填",
          "type": "object",
          "properties": {
            "updateTarget": {
              "type": "string",
              "enum": [
                "subject_extension"
              ]
            },
            "subjectExtensionPatch": {
              "type": "object",
              "description": "subject_extension 时：只允许本学科分支 subjectExtensions.chinese",
              "properties": {
                "chinese": {
                  "type": "object"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "updateTarget"
          ]
        }
      }
    },
    "timestamp": {
      "description": "ISO-8601格式的时间戳",
      "type": "string",
      "format": "date-time"
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "description": "发送方在发送前核对过的授权位快照（来自 dna-profile meta.consentStatus，见 shared/vocab.md §8）。接收方必须再次核对；任一相关位为 false 时丢弃该交接并告知用户",
      "properties": {
        "crossSkillSharing": {
          "type": "boolean"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "crossSkillSharing"
      ]
    }
  },
  "required": [
    "sessionId",
    "protocolVersion",
    "handoverType",
    "sender",
    "recipient",
    "consent",
    "payload",
    "timestamp"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "handoverType": {
            "enum": [
              "subject_profile_writeback"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "profileData"
            ]
          }
        }
      }
    }
  ]
}
