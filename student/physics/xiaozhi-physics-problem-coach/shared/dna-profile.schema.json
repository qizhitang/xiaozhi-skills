{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaozhi-skills.openclaw.dev/schemas/dna-profile.schema.json",
  "title": "LearningDNAProfile",
  "x-distributed-to": "xiaozhi-physics-problem-coach",
  "x-skill-scope": {
    "note": "本副本随 xiaozhi-physics-problem-coach 分发，已按其 SKILL.md 裁剪：只保留正文在非否定语境下提到的字段（共 5 项，删去 8 个顶层字段）。完整定义在归属技能处。读/写权限与授权位以 SKILL.md 为准。",
    "paths": [
      "interestDNA",
      "meta",
      "safetyRecord",
      "subjectExtensions.physics",
      "subjectMap"
    ]
  },
  "description": "学习DNA —— 小智长期记忆核心引擎的数据结构定义。覆盖六大基础维度（基础信息、学科强弱、学习风格、错误模式、对话摘要、成长轨迹）、成长图谱与兴趣DNA、学习情绪，以及授权主体与学段、学科扩展档案 subjectExtensions、通用扩展档案 extensions、安全处置记录 safetyRecord。所有词表以 shared/vocab.md 为唯一来源。所有字段均为可选，默认只记录完成个性化辅导所必需的最小信息。本 schema 由 xiaozhi-learning-dna 定义并保管，它本身不产生错因、理解、情绪等判断，这些维度由对应技能经 handover 在授权后写入。其他技能随包附带的副本仅供字段名参照：各技能实际可读写的路径以副本顶部的 x-skill-scope 与其 SKILL.md 接口节为准。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "meta": {
      "description": "档案元数据：版本、创建时间、授权状态",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profileId": {
          "type": "string",
          "description": "档案唯一标识符，由平台自动生成",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "schemaVersion": {
          "type": "string",
          "description": "档案结构版本号，与仓库版本一致（当前 2.1.6）。旧档案（1.0.0–1.3.0）的字段在本结构中全部保留且均为可选，迁移时只需把本字段改写为 2.1.0。",
          "enum": [
            "2.1.6"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "首次建档时间（ISO 8601）"
        },
        "lastUpdatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "最近一次更新时间（ISO 8601）"
        },
        "consentStatus": {
          "description": "授权状态：用户对长期档案的当前授权情况",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profileEnabled": {
              "type": "boolean",
              "description": "用户是否已同意开启长期档案",
              "default": false
            },
            "memoryPaused": {
              "type": "boolean",
              "description": "是否暂停记忆（本次不读取也不写入）",
              "default": false
            },
            "crossSkillSharing": {
              "type": "boolean",
              "description": "是否允许跨SKILL共享最小字段摘要",
              "default": false
            },
            "reminderConsent": {
              "type": "boolean",
              "description": "是否同意接收IM提醒",
              "default": false
            },
            "interestTrackingConsent": {
              "type": "boolean",
              "description": "是否同意记录兴趣偏好",
              "default": false
            },
            "emotionTrackingConsent": {
              "type": "boolean",
              "description": "是否同意记录学习情绪数据（默认关闭，需单独授权）",
              "default": false
            },
            "consentGivenBy": {
              "type": "string",
              "enum": [
                "学生本人",
                "监护人",
                "学生与监护人",
                "未记录"
              ],
              "default": "未记录",
              "description": "同意主体（shared/vocab.md §8）。profileEnabled=true 时应为 学生本人/监护人/学生与监护人；ageBand 为小学各段时必须包含监护人"
            },
            "ageBand": {
              "$ref": "#/$defs/ageBand",
              "description": "学段（shared/vocab.md §10），用于推导 guardianConsentRequired 与学段参数"
            },
            "guardianConsentRequired": {
              "type": "boolean",
              "default": false,
              "description": "是否需要监护人同意（小学各段为 true；初中由 SKILL 询问年龄后判断，约 ≤14 周岁为 true）"
            },
            "parentSharingConsent": {
              "type": "boolean",
              "default": false,
              "description": "允许把学习摘要输出给家长/监护人（家庭看板、月报家长页、家长简报）。默认 false"
            },
            "emotionSharingWithParent": {
              "type": "boolean",
              "default": false,
              "description": "允许把情绪相关内容输出给家长。独立于 parentSharingConsent，必须学生本人同意。默认 false。危机例外（shared/crisis-exception.md）不受此位限制"
            },
            "teacherWritebackConsent": {
              "type": "boolean",
              "default": false,
              "description": "允许老师端 SKILL 写回本档案。默认 false"
            },
            "grantedAt": {
              "type": "string",
              "format": "date-time",
              "description": "最近一次授权变更时间"
            },
            "lastReviewedAt": {
              "type": "string",
              "format": "date-time",
              "description": "最近一次向用户复述授权状态的时间（建议每学期一次）"
            }
          }
        }
      },
      "required": [
        "profileId",
        "schemaVersion",
        "createdAt",
        "consentStatus"
      ]
    },
    "subjectMap": {
      "description": "二、学科强弱地图：各科强项与薄弱项的结构化记录",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strengths": {
          "type": "array",
          "description": "强项科目及具体章节",
          "items": {
            "$ref": "#/$defs/subjectEntry"
          }
        },
        "weaknesses": {
          "type": "array",
          "description": "薄弱科目及根本原因",
          "items": {
            "$ref": "#/$defs/subjectEntry"
          }
        },
        "weakKnowledgePoints": {
          "type": "array",
          "description": "薄弱知识点清单（细化到知识点层级）",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "subject": {
                "type": "string",
                "description": "学科名称",
                "examples": [
                  "语文",
                  "数学",
                  "英语",
                  "物理",
                  "化学"
                ]
              },
              "chapter": {
                "type": "string",
                "description": "所属章节"
              },
              "knowledgePoint": {
                "type": "string",
                "description": "知识点名称"
              },
              "rootCause": {
                "type": "string",
                "description": "薄弱根本原因（一句话概括）"
              },
              "status": {
                "$ref": "#/$defs/weaknessStatus"
              },
              "confidenceLevel": {
                "$ref": "#/$defs/confidenceLevel"
              }
            },
            "required": [
              "subject",
              "knowledgePoint"
            ]
          }
        }
      }
    },
    "interestDNA": {
      "description": "兴趣DNA：仅在用户使用兴趣成长探索计划且同意记录时同步",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currentExploringFields": {
          "type": "array",
          "description": "当前正在探索的领域",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fieldName": {
                "type": "string"
              },
              "startedDate": {
                "type": "string",
                "format": "date"
              },
              "explorationWeeks": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "fieldName"
            ]
          }
        },
        "challengeReactionSignals": {
          "type": "array",
          "description": "各领域挑战反应信号",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fieldName": {
                "type": "string"
              },
              "reactionSignal": {
                "type": "string",
                "description": "挑战反应信号",
                "enum": [
                  "放弃信号",
                  "继续信号",
                  "确认兴趣"
                ]
              },
              "confidenceLevel": {
                "$ref": "#/$defs/confidenceLevel"
              }
            },
            "required": [
              "fieldName",
              "reactionSignal"
            ]
          }
        },
        "confirmedShallowLikes": {
          "type": "array",
          "description": "已确认浅层喜好的领域",
          "items": {
            "type": "string"
          }
        },
        "possibleTrueInterests": {
          "type": "array",
          "description": "可能真正兴趣的领域",
          "items": {
            "type": "string"
          }
        },
        "lastUpdated": {
          "type": "string",
          "format": "date",
          "description": "兴趣DNA最后更新日期"
        }
      }
    },
    "subjectExtensions": {
      "type": "object",
      "additionalProperties": false,
      "description": "学科扩展档案。每个学科 SKILL 只读写本学科分支（数学 SKILL 只写 math，物理只写 physics，语文只写 chinese，英语只写 english），且受 consentStatus.crossSkillSharing 约束。写入一律经 handover 的 subject_profile_writeback",
      "properties": {
        "physics": {
          "type": "object",
          "additionalProperties": false,
          "description": "物理错误DNA、建模教练、实验教练的学科层档案",
          "properties": {
            "subtypes": {
              "$ref": "#/$defs/subjectSubtypeMap"
            },
            "modelingProfile": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "model": {
                    "type": "string",
                    "maxLength": 60,
                    "description": "物理模型名（如 匀速直线运动/浮力平衡/串并联电路）"
                  },
                  "status": {
                    "$ref": "#/$defs/masteryLevel"
                  },
                  "lastDate": {
                    "type": "string",
                    "format": "date"
                  }
                },
                "required": [
                  "model",
                  "status"
                ]
              }
            },
            "labSkills": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "skill": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "status": {
                    "$ref": "#/$defs/masteryLevel"
                  },
                  "lastDate": {
                    "type": "string",
                    "format": "date"
                  }
                },
                "required": [
                  "skill",
                  "status"
                ]
              }
            }
          }
        }
      }
    },
    "safetyRecord": {
      "type": "object",
      "additionalProperties": false,
      "description": "安全处置记录。只记处置事实，禁止记录事件细节、原话、家庭信息（shared/crisis-exception.md）",
      "properties": {
        "crisisReferrals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "actionsTaken": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "已稳住并说明AI边界",
                    "已建议联系信任的成年人",
                    "已提示监护人",
                    "已提供专业求助渠道",
                    "已建议紧急求助110/120"
                  ]
                }
              },
              "followUpStatus": {
                "type": "string",
                "enum": [
                  "未跟进",
                  "已温和确认",
                  "已连接到成年人/专业支持"
                ]
              }
            },
            "required": [
              "date",
              "actionsTaken"
            ]
          }
        }
      }
    }
  },
  "required": [
    "meta"
  ],
  "$defs": {
    "confidenceLevel": {
      "description": "结论置信度标签（shared/vocab.md §7）：防止数据不足时给出误导性结论。样本不足（insufficient_sample）只作输出标签，不可写入本档案，故不在枚举内。凡是基于'连续N次'得出的AI结论必须附带此标签。data_sufficient=🟢数据充分（≥3 次独立观察且方向一致）；preliminary_trend=🟡初步趋势（2 次观察或方向基本一致）；insufficient_sample=🔴样本不足（单次观察或互相矛盾，不写入长期档案）",
      "type": "string",
      "enum": [
        "data_sufficient",
        "preliminary_trend"
      ]
    },
    "subjectEntry": {
      "description": "学科条目：用于强项和弱项列表",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject": {
          "type": "string",
          "description": "学科名称",
          "examples": [
            "语文",
            "数学",
            "英语",
            "物理",
            "化学",
            "生物",
            "历史",
            "地理",
            "政治"
          ]
        },
        "chapters": {
          "type": "array",
          "description": "具体章节或知识点",
          "items": {
            "type": "string"
          }
        },
        "rootCause": {
          "type": "string",
          "description": "薄弱的根本原因（仅弱项使用）"
        },
        "confidenceLevel": {
          "$ref": "#/$defs/confidenceLevel"
        }
      },
      "required": [
        "subject"
      ]
    },
    "errorDimension": {
      "type": "string",
      "enum": [
        "概念模糊",
        "计算失误",
        "读题失误",
        "方法用错"
      ],
      "description": "错因基础四维（shared/vocab.md §1）。学科子类型见 subtypeId"
    },
    "weaknessStatus": {
      "type": "string",
      "enum": [
        "待处理",
        "初步弱项",
        "突破中",
        "顽固弱项",
        "已攻克"
      ],
      "description": "弱项状态五档（shared/vocab.md §4）"
    },
    "masteryLevel": {
      "type": "string",
      "enum": [
        "会复述",
        "会解释",
        "真正掌握"
      ],
      "description": "掌握度三档（shared/vocab.md §6）"
    },
    "ageBand": {
      "type": "string",
      "enum": [
        "小学低段",
        "小学中段",
        "小学高段",
        "初中",
        "高中",
        "未知"
      ],
      "description": "学段（shared/vocab.md §10）"
    },
    "subtypeRecord": {
      "type": "object",
      "additionalProperties": false,
      "description": "学科子类型记录（shared/vocab.md §2）。通用层只存 ID，不解释含义",
      "properties": {
        "subtypeId": {
          "type": "string",
          "pattern": "^(RC|AR|WT|CL|LG|[A-Z])[0-9]{2}$",
          "description": "学科子类型编码，如 B03 / P02 / G05 / RC01"
        },
        "dimension": {
          "$ref": "#/$defs/errorDimension"
        },
        "knowledgePoint": {
          "type": "string",
          "maxLength": 100
        },
        "occurrenceCount": {
          "type": "integer",
          "minimum": 0
        },
        "windowStart": {
          "type": "string",
          "format": "date",
          "description": "28 天滚动窗口起点（shared/vocab.md §5）"
        },
        "status": {
          "$ref": "#/$defs/weaknessStatus"
        },
        "lastOccurrenceDate": {
          "type": "string",
          "format": "date"
        },
        "confidenceLevel": {
          "$ref": "#/$defs/confidenceLevel"
        }
      },
      "required": [
        "subtypeId",
        "knowledgePoint",
        "status"
      ]
    },
    "subjectSubtypeMap": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/subtypeRecord"
      }
    }
  }
}
