{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaozhi-skills.openclaw.dev/schemas/handover-protocol.schema.json",
  "title": "XiaozhiMultiAgentHandoverProtocol",
  "x-distributed-to": "xiaozhi-physics-modeling-coach",
  "x-skill-scope": {
    "note": "本副本随 xiaozhi-physics-modeling-coach 分发，已按其 SKILL.md 裁剪：只保留正文在非否定语境下提到的交接类型（共 2 项，删去 0 个顶层字段）。完整定义在归属技能处。读/写权限与授权位以 SKILL.md 为准。",
    "paths": [
      "subject_profile_writeback",
      "reminder_enqueue"
    ]
  },
  "description": "小智伴学多智能体协作与数据流转协议 (2.1.1)。sender/recipient 覆盖全库 58 个 SKILL；词表以 shared/vocab.md 为唯一来源。",
  "type": "object",
  "properties": {
    "sessionId": {
      "description": "当前会话的唯一ID标识，用于跟踪跨智能体对话流",
      "type": "string"
    },
    "protocolVersion": {
      "description": "协议版本，与仓库版本一致（当前 2.1.6）",
      "type": "string",
      "enum": [
        "2.1.6"
      ]
    },
    "handoverType": {
      "description": "交接类型：wrong_answer_handover=错题本→学科错误DNA；deep_analysis_writeback=学科错误DNA→错题本回写；profile_writeback=写入学习DNA通用层；subject_profile_writeback=写入学习DNA subjectExtensions/extensions；reminder_enqueue=向IM提醒入队（唯一允许的提醒方式）；reminder_sync=IM提醒回报状态；teacher_writeback=老师端写回学生档案（需 consent.teacherWritebackConsent）",
      "type": "string",
      "enum": [
        "subject_profile_writeback",
        "reminder_enqueue"
      ]
    },
    "sender": {
      "description": "发送数据的源SKILL名称",
      "type": "string",
      "enum": [
        "xiaozhi-physics-modeling-coach"
      ]
    },
    "recipient": {
      "description": "接收数据的目标SKILL名称",
      "type": "string",
      "enum": [
        "xiaozhi-learning-dna",
        "xiaozhi-physics-error-dna"
      ]
    },
    "payload": {
      "description": "数据负载主体，结构根据 handoverType 动态变化",
      "type": "object",
      "properties": {
        "profileData": {
          "description": "DNA回写专属结构。在 handoverType='profile_writeback' 时必填",
          "type": "object",
          "properties": {
            "updateTarget": {
              "type": "string",
              "enum": [
                "concept_graph",
                "emotion_dimension",
                "growth_milestones",
                "subject_extension",
                "extension",
                "safety_record",
                "weak_knowledge_points"
              ]
            },
            "graphUpdates": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "nodeId": {
                    "type": "string"
                  },
                  "conceptName": {
                    "type": "string"
                  },
                  "subject": {
                    "type": "string"
                  },
                  "masteryLevel": {
                    "type": "string",
                    "enum": [
                      "会复述",
                      "会解释",
                      "真正掌握"
                    ]
                  },
                  "relationships": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "relationType": {
                          "type": "string",
                          "enum": [
                            "requires",
                            "isParentOf",
                            "appliesTo",
                            "correlatesWith"
                          ]
                        },
                        "targetNodeId": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "relationType",
                        "targetNodeId"
                      ]
                    }
                  }
                },
                "required": [
                  "conceptName",
                  "subject",
                  "masteryLevel"
                ]
              }
            },
            "emotionUpdates": {
              "type": "object",
              "properties": {
                "baseline": {
                  "type": "string",
                  "enum": [
                    "积极稳定",
                    "波动中",
                    "低落倾向",
                    "焦虑明显"
                  ]
                },
                "subjectEmotions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "subject": {
                        "type": "string"
                      },
                      "emotionType": {
                        "type": "string",
                        "enum": [
                          "自信愉悦",
                          "平静专注",
                          "紧张但能应对",
                          "焦虑回避",
                          "挫败抗拒"
                        ]
                      }
                    },
                    "required": [
                      "subject",
                      "emotionType"
                    ]
                  }
                }
              }
            },
            "milestone": {
              "type": "object",
              "properties": {
                "milestoneName": {
                  "type": "string"
                },
                "milestoneType": {
                  "type": "string",
                  "enum": [
                    "weakness_solved",
                    "feynman_mastered",
                    "system_health_excellent"
                  ]
                },
                "triggerDate": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "milestoneName",
                "milestoneType"
              ]
            },
            "subjectExtensionPatch": {
              "type": "object",
              "description": "subject_extension 时：dna-profile.schema.json#/properties/subjectExtensions 的单学科分支片段（仅本学科）",
              "additionalProperties": true
            },
            "extensionPatch": {
              "type": "object",
              "description": "extension 时：dna-profile.schema.json#/properties/extensions 的单分支片段",
              "additionalProperties": true
            },
            "safetyRecordEntry": {
              "type": "object",
              "description": "safety_record 时：dna-profile.schema.json#/properties/safetyRecord/crisisReferrals 的单条记录（只记处置事实）",
              "additionalProperties": true
            },
            "weakKnowledgePointUpdates": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "subject": {
                    "type": "string",
                    "maxLength": 20
                  },
                  "knowledgePoint": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "待处理",
                      "初步弱项",
                      "突破中",
                      "顽固弱项",
                      "已攻克"
                    ]
                  },
                  "confidenceLevel": {
                    "type": "string",
                    "enum": [
                      "data_sufficient",
                      "preliminary_trend",
                      "insufficient_sample"
                    ]
                  }
                },
                "required": [
                  "subject",
                  "knowledgePoint",
                  "status"
                ]
              }
            }
          },
          "required": [
            "updateTarget"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "updateTarget": {
                    "const": "emotion_dimension"
                  }
                }
              },
              "then": {
                "required": [
                  "emotionUpdates"
                ]
              }
            }
          ]
        },
        "reminderData": {
          "description": "提醒同步专属结构。在 handoverType='reminder_sync' 时必填",
          "type": "object",
          "properties": {
            "reminderId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "spaced_review",
                "error_review",
                "vocab_daily_card",
                "scheduled_task",
                "exploration_task",
                "daily_confirmation",
                "weekly_review",
                "exam_day"
              ]
            },
            "scheduledTime": {
              "type": "string",
              "format": "date-time"
            },
            "content": {
              "type": "string"
            },
            "targetKnowledgePoint": {
              "type": "string"
            },
            "priority": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "description": "1 最高。IM提醒按 shared/vocab.md §9 合并为每日摘要"
            },
            "mergeable": {
              "type": "boolean",
              "default": true,
              "description": "是否可并入每日合并摘要；false 表示申请即时提醒（每日最多 1 条）"
            },
            "dueDate": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "reminderId",
            "type",
            "scheduledTime",
            "content"
          ]
        }
      }
    },
    "timestamp": {
      "description": "ISO-8601格式的时间戳",
      "type": "string",
      "format": "date-time"
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "description": "发送方在发送前核对过的授权位快照（来自 dna-profile meta.consentStatus，见 shared/vocab.md §8）。接收方必须再次核对；任一相关位为 false 时丢弃该交接并告知用户",
      "properties": {
        "crossSkillSharing": {
          "type": "boolean"
        },
        "emotionTrackingConsent": {
          "type": "boolean",
          "description": "情绪数据记录授权。updateTarget=emotion_dimension 时必须为 true"
        },
        "teacherWritebackConsent": {
          "type": "boolean"
        },
        "reminderConsent": {
          "type": "boolean"
        },
        "parentSharingConsent": {
          "type": "boolean",
          "description": "允许把学习摘要输出给家长。生成任何家长可见内容前必须核对"
        },
        "emotionSharingWithParent": {
          "type": "boolean",
          "description": "允许把情绪相关内容输出给家长。独立于 parentSharingConsent，必须学生本人同意"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "crossSkillSharing"
      ]
    }
  },
  "required": [
    "sessionId",
    "protocolVersion",
    "handoverType",
    "sender",
    "recipient",
    "consent",
    "payload",
    "timestamp"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "handoverType": {
            "enum": [
              "profile_writeback",
              "subject_profile_writeback"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "profileData"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "handoverType": {
            "enum": [
              "reminder_enqueue",
              "reminder_sync"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "reminderData"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "payload"
        ],
        "properties": {
          "payload": {
            "required": [
              "profileData"
            ],
            "properties": {
              "profileData": {
                "required": [
                  "updateTarget"
                ],
                "properties": {
                  "updateTarget": {
                    "const": "emotion_dimension"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "consent": {
            "properties": {
              "emotionTrackingConsent": {
                "const": true
              }
            },
            "required": [
              "emotionTrackingConsent"
            ]
          }
        }
      }
    }
  ]
}
